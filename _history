s right, -1 faces left. col = shorts and gloves, skin = skin colour.\r\nfunction drawBoxer(t: Image, x: number, feet: number, dir: number, col: number, skin: number, pose: number) {\r\n    let ox = 0\r\n    let hdx = 0\r\n    let hdy = 0\r\n    if (pose == 5) { ox = -dir * 5; hdx = -dir * 3; hdy = 3 }\r\n    else if (pose == 6) { ox = -dir * 3; hdx = -dir * 2 }\r\n    else if (pose == 7) { ox = -dir * 5 }\r\n    const bob = Math.round(Math.sin(control.millis() / 220))\r\n    const bx = x + ox\r\n    const hip = feet - 9\r\n    const sx = bx + dir * 2\r\n    const sy = hip - 13 + bob\r\n    // glove positions (lead = front hand, rear = back hand)\r\n    let lx = bx + dir * 9\r\n    let ly = hip - 14 + bob\r\n    let rx = bx + dir * 5\r\n    let ry = hip - 11 + bob\r\n    if (pose == 1) { lx = bx + dir * 21; ly = hip - 15 }\r\n    else if (pose == 2) { rx = bx + dir * 21; ry = hip - 13; lx = bx + dir * 8; ly = hip - 17 }\r\n    else if (pose == 3) { lx = bx + dir * 14; ly = hip - 19 }\r\n    else if (pose == 4) { lx = bx + dir * 7; ly = hip - 19; rx = bx + dir * 5; ry = hip - 17 }\r\n    else if (pose == 6) { lx = bx + dir * 4; ly = hip - 8; rx = bx + dir * 2; ry = hip - 7 }\r\n    // shadow and legs\r\n    t.fillRect(bx - 7, feet + 1, 15, 2, 15)\r\n    t.drawLine(bx, hip, bx + dir * 4, feet, skin)\r\n    t.drawLine(bx + 1, hip, bx + dir * 4 + 1, feet, skin)\r\n    t.drawLine(bx, hip, bx - dir * 3, feet, skin)\r\n    t.drawLine(bx + 1, hip, bx - dir * 3 + 1, feet, skin)\r\n    t.fillRect(Math.min(bx + dir * 4, bx + dir * 4 + dir * 3), feet - 1, 4, 2, 15)\r\n    t.fillRect(Math.min(bx - dir * 3, bx - dir * 3 + dir * 3), feet - 1, 4, 2, 15)\r\n    // rear arm\r\n    t.drawLine(sx, sy, rx, ry, skin)\r\n    t.drawLine(sx, sy + 1, rx, ry + 1, skin)\r\n    t.fillCircle(rx, ry, 3, col)\r\n    // torso and shorts\r\n    t.fillRect(bx - 4, hip - 15 + bob, 9, 12, skin)\r\n    t.drawLine(bx - 2, hip - 8, bx + 2, hip - 8, 14)\r\n    t.fillRect(bx - 4, hip - 4, 9, 6, col)\r\n    t.drawLine(bx - 4, hip - 4, bx + 4, hip - 4, 1)\r\n    // head\r\n    const hx = bx + hdx + dir\r\n    const hy = hip - 20 + hdy + bob\r\n    t.fillCircle(hx, hy, 4, skin)\r\n    t.fillCircle(hx - dir, hy - 1, 4, col)\r\n    t.fillCircle(hx + dir * 2, hy + 1, 2, skin)\r\n    if (pose == 6) {\r\n        t.setPixel(hx + dir * 2, hy, 15)\r\n        t.setPixel(hx + dir * 4, hy, 15)\r\n        t.drawLine(hx + dir * 6, hy - 4, hx + dir * 9, hy - 6, 5)\r\n        t.drawLine(hx + dir * 7, hy, hx + dir * 10, hy, 5)\r\n        t.drawLine(hx + dir * 6, hy + 4, hx + dir * 9, hy + 6, 5)\r\n    } else {\r\n        t.setPixel(hx + dir * 3, hy, 15)\r\n    }\r\n    // lead arm\r\n    if (pose == 3) { t.drawLine(sx, sy, bx + dir * 9, ly - 3, skin); t.drawLine(bx + dir * 9, ly - 3, lx, ly, skin) }\r\n    else { t.drawLine(sx, sy, lx, ly, skin); t.drawLine(sx, sy + 1, lx, ly + 1, skin) }\r\n    t.fillCircle(lx, ly, 3, col)\r\n    t.setPixel(lx + 1, ly - 2, 1)\r\n}\r\n// SCREENS: how every screen looks. No game rules in here, only drawing.\r\n"]]},{"start1":7050,"length1":302,"diffs":[[1,"function bar(t: Image, x: number, y: number, w: number, h: number, pct: number, col: number) {\r\n    t.fillRect(x, y, w, h, 12)\r\n    const fw = Math.round(w * Math.max(0, Math.min(100, pct)) / 100)\r\n    if (fw > 0) t.fillRect(x, y, fw, h, col)\r\n"]]},{"start1":7299,"length1":438,"diffs":[[1,"function printLines(t: Image, lines: string[], x: number, y: number, col: number, maxLines: number, step: number) {\r\n    for (let i = 0; i < lines.length && i < maxLines; i++) t.print(lines[i], x, y + i * step, col, image.font5)\r\n"]]},{"start1":7534,"length1":263,"diffs":[[1,"function skillRows(t: Image, y0: number, gap: number) {\r\n    for (let c = 0; c < 4; c++) {\r\n        const y = y0 + c * gap\r\n        const pct = catPct(c)\r\n        t.print(CAT_NAME[c], 4, y, 1, image.font5)\r\n        bar(t, 62, y, 70, 5, pct, 7)\r\n        t.print(pct + \"%\", 136, y, 11, image.font5)\r\n    }\r\n"]]},{"start1