3, 5) }\r\n            else t.drawRect(x, y, 51, 13, 12)\r\n            t.print(ACT_NAME[i], x + 3, y + 1, dim ? 11 : 1, image.font5)\r\n            t.print((ACT_COST[i] > 0 ? \"-\" : \"+\") + Math.abs(ACT_COST[i]) + \" sta\", x + 3, y + 7, 11, image.font5)\r\n        }\r\n        t.print(\"A: choose  B: exit\", 2, 114, 11, image.font5)\r\n    } else if (mPhase == 2) {\r\n        t.fillRect(0, 85, 160, 35, 15)\r\n        t.drawRect(0, 85, 160, 34, mCls == 1 ? 7 : 2)\r\n        printLines(t, logLines, 3, 88, 1, 5, 6)\r\n        t.print(\">\", 150, 111, 5, image.font5)\r\n"]]},{"start1":11785,"length1":101,"diffs":[[1,""]]},{"start1":11790,"length1":910,"diffs":[[1,"function drawEnd(t: Image) {\r\n    t.printCenter(mAi < mHp ? \"YOU WON ON POINTS\" : \"BOUT OVER\", 3, mAi < mHp ? 7 : 2, image.font8)\r\n    t.printCenter(\"Best reads: \" + mGood + \" of \" + mTot, 17, 5, image.font8)\r\n    printLines(t, wrapText(MSG_NOTE, 26), 4, 32, 1, 3, 7)\r\n    printLines(t, endLines, 4, 58, 11, 4, 7)\r\n    t.print(\"Your stamina at the end\", 4, 90, 1, image.font5)\r\n    bar(t, 4, 98, 100, 5, mSta, 5)\r\n    t.printCenter(\"A: hub    B: fight again\", 110, 5, image.font5)\r\n"]]},{"start1":12277,"length1":42,"diffs":[[1,"// everything drawn each frame\r\n"]]},{"start1":12343,"length1":668,"diffs":[[1,"    t.fill(15)\r\n    if (screen == SC_HUB) drawHub(t)\r\n    else if (screen == SC_DRILL) drawDrill(t)\r\n    else if (screen == SC_DONE) drawDone(t)\r\n    else if (screen == SC_MATCH) drawMatch(t)\r\n    else drawEnd(t)\r\n"]]},{"start1":12560,"length1":69,"diffs":[[1,"// MECHANIC: rules and input. The drill, the turn-based bout and the buttons.\r\nconst SC_HUB = 0\r\nconst SC_DRILL = 1\r\nconst SC_DONE = 2\r\nconst SC_MATCH = 3\r\nconst SC_END = 4\r\n"]]},{"start1":12736,"length1":227,"diffs":[[1,"let screen = SC_HUB\r\nlet cursor = 0          // hub menu position\r\nlet busy = false        // true while a dialog is open\r\n"]]},{"start1":12861,"length1":755,"diffs":[[1,"// ----- training drill -----\r\nlet results: number[] = [-1, -1, -1, -1, -1]   // -1 not answered, 0 wrong, 1 right\r\nlet dIdx = 0\r\nlet dSel = 0\r\nlet qLines: string[] = []\r\n\r\nfunction drillStarted(): boolean { return results[0] >= 0 }\r\nfunction drillScore(): number {\r\n    let s = 0\r\n    for (let i = 0; i < results.length; i++) if (results[i] == 1) s++\r\n    return s\r\n}\r\nfunction drillDone(): boolean { return results[results.length - 1] >= 0 }\r\nfunction passed(): boolean { return drillDone() && drillScore() >= 4 }\r\nfunction catPct(cat: number): number {\r\n    let n = 0\r\n    let ok = 0\r\n    for (let i = 0; i < Q_CAT.length; i++) {\r\n        if (Q_CAT[i] == cat && results[i] >= 0) { n++; if (results[i] == 1) ok++ }\r\n"]]},{"start1":13586,"length1":0,"diffs":[[1,"    if (n == 0) return 0\r\n    return Math.round(100 * ok / n)\r\n"]]},{"start1":13652,"length1":197,"diffs":[[1,"function setQuestion() { qLines = wrapText(Q_TEXT[dIdx], 26) }\r\nfunction startDrill() {\r\n    results = [-1, -1, -1, -1, -1]\r\n    dIdx = 0\r\n    dSel = 0\r\n    setQuestion()\r\n    screen = SC_DRILL\r\n"]]},{"start1":13850,"length1":0,"diffs":[[1,"function confirmAnswer() {\r\n    busy = true\r\n    const ok = dSel == Q_ANS[dIdx]\r\n    results[dIdx] = ok ? 1 : 0\r\n    game.showLongText((ok ? \"CORRECT\\n\\n\" : \"NOT QUITE\\n\\n\") + Q_WHY[dIdx], DialogLayout.Full)\r\n    if (dIdx + 1 < Q_TEXT.length) { dIdx++; dSel = 0; setQuestion() }\r\n    else screen = SC_DONE\r\n    busy = false\r\n}\r\n"]]},{"start1":14180,"length1":63,"diffs":[[1,"// ----- turn-based bout: 3 rounds of 5 exchanges -----\r\nlet mHp = 100\r\nlet mAi = 100\r\nlet mSta = 100\r\nlet mAsta = 100\r\nlet mR = 1\r\nlet mT = 1\r\nlet mGood = 0\r\nlet mTot = 0\r\nlet mCue = 0\r\nlet mCur = 0\r\nlet mCls = 0            // 1 fine, 2 poor (colours the feedback box)\r\nlet mPhase = 0          // 0 choose a move, 1 animation, 2 feedback\r\nlet mEnd = false\r\nlet mPPose = 0\r\nlet mAPose = 0\r\nlet mAnimEnd = 0\r\nlet mLog = \"\"\r\nlet mMiss: number[] = [0, 0, 0, 0]\r\nlet cueLines: string[] = []\r\nlet logLines: string[] = []\r\nlet endLines: string[] = []\r\n"]]},{"start1":14728,"length1":780,"diffs":[[1,"function has(list: number[], v: number): boolean {\r\n    for (let i = 0; i < list.length; i++) if (list[i] == v) return true\r\n    return false\r\n"]]},{"start1":14876,"length1":2229,"diffs":[[1,"function newCue() {\r\n    const w = mAi < 35 ? [2, 2, 2, 0, 1, 3] : [0, 1, 3, 0, 1, 3, 2]\r\n    mCue = w[Math.randomRange(0, w.length - 1)]\r\n    cueLines = wrapText(CUE_TEXT[mCue], 24)\r\n"]]},{"start1":15065,"length1":591,"diffs":[[1,"function startMatch() {\r\n    mHp = 100; mAi = 100; mSta = 100; mAsta = 100\r\n    mR = 1; mT = 1; mGood = 0; mTot = 0; mCur = 0\r\n    mMiss = [0, 0, 0, 0]\r\n    mEnd = false; mCls = 0; mPhase = 0; mPPose = 0; mAPose = 0\r\n    mLog = MSG_START\r\n    newCue()\r\n    screen = SC_MATCH\r\n"]]},{"start1":15346,"length1":389,"diffs":[[1,"// pick the moves shown during the short animation\r\nfunction setPoses(a: number, dealt: number, taken: number, tired: boolean) {\r\n    mPPose = 0\r\n    mAPose = 0\r\n    if (tired) return\r\n    if (dealt > 0) {\r\n        mPPose = a == 4 ? 1 : a + 1\r\n        mAPose = 6\r\n    } else if (a == 3) mPPose = 4\r\n    else if (a == 4) mPPose = 5\r\n    else if (a == 5) mPPose = 7\r\n    if (taken > 0) {\r\n        mAPose = mCue == 1 ? 3 : 1\r\n        if (dealt == 0) mPPose = 6\r\n    } else if (CUE_ATK[mCue] == 1 && dealt == 0) mAPose = 3\r\n"]]},{"start1":15871,"length1":2527,"diffs":[[1,"function doAction(a: number) {\r\n    let dealt = 0\r\n    let taken = 0\r\n    let note = \"\"\r\n    let tired = false\r\n    mCls = 2\r\n    if (ACT_COST[a] > mSta) {\r\n        tired = true\r\n        note = MSG_TIRED\r\n"]]},{"start1":16090,"length1":891,"diffs":[[1,"        if (has(CUE_GOOD[mCue], a)) {\r\n            mCls = 1\r\n            dealt = ACT_POW[a]\r\n            note = MSG_GOOD + CUE_TIP[mCue]\r\n            mGood++\r\n        } else if (has(CUE_OK[mCue], a)) {\r\n            mCls = 1\r\n            dealt = Math.round(ACT_POW[a] / 2)\r\n            if (CUE_ATK[mCue] == 1) taken = 4\r\n            note = MSG_OK + CUE_TIP[mCue]\r\n        } else {\r\n            if (CUE_ATK[mCue] == 1) taken = 10\r\n            else if (ACT_POW[a] > 0) taken = 4\r\n            note = MSG_BAD + CUE_TIP[mCue]\r\n            mMiss[mCue]++\r\n"]]},{"start1":16649,"length1":295,"diffs":[[1,"        if (mSta < 20 && dealt > 0) {\r\n            dealt = Math.round(dealt / 2)\r\n            note += MSG_LOW_STA\r\n"]]},{"start1":16775,"length1":0,"diffs":[[1,"        mSta = Math.max(0, Math.min(100, mSta - ACT_COST[a]))\r\n"]]},{"start1":16845,"length1":2198,"diffs":[[1,"    mAi = Math.max(0, mAi - dealt * 2)\r\n    mHp = Math.max(0, mHp - taken)\r\n    mAsta = Math.max(0, mAsta - (dealt > 0 ? 8 : 4))\r\n    mTot++\r\n    mLog = ACT_NAME[a] + \": \" + note\r\n    if (mT >= 5) {\r\n        if (mR >= 3 || mHp <= 0 || mAi <= 0) mEnd = true\r\n        else {\r\n            mR++\r\n            mT = 1\r\n            mSta = Math.min(100, mSta + 20)\r\n            mAsta = Math.min(100, mAsta + 20)\r\n            mLog += \" Round \" + mR + \" begins. You recovered some stamina.\"\r\n            newCue()\r\n        }\r\n"]]},{"start1":17373,"length1":83,"diffs":[[1,"        mT++\r\n        newCue()\r\n"]]},{"start1":17412,"length1":0,"diffs":[[1,"    setPoses(a, dealt, taken, tired)\r\n    mPhase = 1\r\n    mAnimEnd = control.millis() + 700\r\n"]]},{"start1":17510,"length1":1648,"diffs":[[1,"function finishBout() {\r\n    let worst = 0\r\n    for (let i = 1; i < 4; i++) if (mMiss[i] > mMiss[worst]) worst = i\r\n    endLines = []\r\n    if (mMiss[worst] > 0) endLines = wrapText(\"Most missed cue: \" + CUE_TEXT[worst] + \" (\" + mMiss[worst] + \" times)\", 26)\r\n    else endLines = wrapText(\"No missed reads. Excellent.\", 26)\r\n    screen = SC_END\r\n"]]},{"start1":17860,"length1":1396,"diffs":[[1,"// ----- buttons -----\r\n// b: 0 A, 1 B, 2 up, 3 down, 4 left, 5 right\r\nfunction onButton(b: number) {\r\n    if (busy) return\r\n    if (screen == SC_HUB) {\r\n        if (b == 2) cursor = 0\r\n        else if (b == 3) cursor = 1\r\n        else if (b == 0) {\r\n            if (cursor == 0) startDrill()\r\n            else if (passed()) startMatch()\r\n            else { busy = true; game.showLongText(MSG_LOCKED, DialogLayout.Full); busy = false }\r\n"]]},{"start1":18308,"length1":521,"diffs":[[1,"    } else if (screen == SC_DRILL) {\r\n        if (b == 2) dSel = (dSel + 3) % 4\r\n        else if (b == 3) dSel = (dSel + 1) % 4\r\n        else if (b == 0) confirmAnswer()\r\n        else if (b == 1) screen = SC_HUB\r\n    } else if (screen == SC_DONE) {\r\n        if (b == 0) screen = SC_HUB\r\n        else if (b == 1) startDrill()\r\n    } else if (screen == SC_MATCH) {\r\n        if (mPhase == 0) {\r\n            if (b == 4 && mCur % 3 > 0) mCur--\r\n            else if (b == 5 && mCur % 3 < 2) mCur++\r\n            else if (b == 2 && mCur >= 3) mCur -= 3\r\n            else if (b == 3 && mCur < 3) mCur += 3\r\n            else if (b == 0) doAction(mCur)\r\n            else if (b == 1) {\r\n                busy = true\r\n                if (game.ask(\"Leave the bout?\", \"A=yes B=no\")) screen = SC_HUB\r\n                busy = false\r\n"]]},{"start1":19137,"length1":206,"diffs":[[1,"        } else if (mPhase == 2 && b == 0) {\r\n            if (mEnd) finishBout()\r\n            else { mPhase = 0; mPPose = 0; mAPose = 0 }\r\n        }\r\n    } else if (screen == SC_END) {\r\n        if (b == 0) screen = SC_HUB\r\n        else if (b == 1) startMatch()\r\n"]]},{"start1":19405,"length1":335,"diffs":[[1,""]]},{"start1":19410,"length1":1954,"diffs":[[1,""]]},{"start1":19434,"length1":838,"diffs":[[1,"    controller.A.onEvent(ControllerButtonEvent.Pressed, function () { onButton(0) })\r\n    controller.B.onEvent(ControllerButtonEvent.Pressed, function () { onButton(1) })\r\n    controller.up.onEvent(ControllerButtonEvent.Pressed, function () { onButton(2) })\r\n    controller.down.onEvent(ControllerButtonEvent.Pressed, function () { onButton(3) })\r\n    controller.left.onEvent(ControllerButtonEvent.Pressed, function () { onButton(4) })\r\n    controller.right.onEvent(ControllerButtonEvent.Pressed, function () { onButton(5) })\r\n"]]},{"start1":19966,"length1":469,"diffs":[[1,"// ends the short animation after a move\r\nfunction frame() {\r\n    if (screen == SC_MATCH && mPhase == 1 && control.millis() >= mAnimEnd) {\r\n        mPhase = 2\r\n        logLines = wrapText(mLog, 26)\r\n"]]},{"start1":20172,"length1":341,"diffs":[[1,""]]},{"start1":20175,"length1":2436,"diffs":[[1,""]]},{"start1":20243,"length1":291,"diffs":[[1,"//   text.ts       questions, cues and every message\r\n//   character.ts  the boxer figure\r\n//   screens.ts    how each screen looks\r\n//   mechanic.ts   the drill, the bout and the buttons\r\n// Start-up runs in a parallel fiber so every file has finished loading first,\r\n"]]},{"start1":20584,"length1":15,"diffs":[[1,""]]},{"start1":20744,"length1":218,"diffs":[[1,"    setQuestion()\r\n"]]}]},{"type":"edited","filename":"pxt.json","patch":[{"start1":199,"length1":44,"diffs":[[1,""]]}]},{"type":"added","filename":"test.ts","value":"// tests go here; this will not be compiled when this package is used as an extension.\n"},{"type":"added","filename":"main.blocks","value":"<xml xmlns=\"http://www.w3.org/1999/xhtml\">\n  <variables></variables>\n  <block type=\"pxt-on-start\" x=\"0\" y=\"0\"></block>\n</xml>"}]}],"snapshots":[{"timestamp":1795580661724,"editorVersion":"4.1.32","text":{"main.ts":" ","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"Alpha-demo Serious Game\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"preferredEditor\": \"tsprj\",\n    \"languageRestriction\": \"javascript-only\",\n    \"additionalFilePaths\": []\n}\n"}},{"timestamp":1795669886342,"editorVersion":"4.1.32","text":{"main.ts":"// BOXING SERIOUS GAME - MakeCode Arcade port (TypeScript)\r\n// Paste into a new Arcade project: open the JavaScript view and replace main.ts.\r\n// Controls: Left/Right move | A jab | B cross | A+B together = hook\r\n//           Up = dodge (hold Right: dash in, stand still: duck, hold Left: dash away)\r\n//           Down (hold) = block | Menu = pause\r\n// This is a simulation for learning. It does not replace a real coach.\r\n\r\nconst S = 0.3          // world units -> screen pixels\r\nconst FY = 312         // floor line in world units\r\nconst FLOOR = 98       // floor line on screen\r\nconst TH = 0, LD = 1, BK = 2, GH = 3, LO = 4, PD = 5, CN = 6   // stat slots\r\nconst ST_TITLE = 0, ST_INTRO = 1, ST_FIGHT = 2, ST_KO = 3, ST_DIALOG = 4\r\n// punches: [startup, active, recovery, damage, stamina cost, reach]\r\nconst PN = [[6, 3, 8, 4, 5, 92], [22, 4, 14, 10, 12, 104], [32, 4, 20, 15, 18, 88]]\r\nconst PNAME = [\"jab\", \"cross\", \"hook\"]\r\n\r\nclass Fighter {\r\n    x: number; dir: number; ai: boolean\r\n    hp = 100; sta = 100; p = -1; t = 0; stun = 0; blk = false\r\n    inv = 0; vx = 0; fl = 0; hit = false; exp = 0; grace = 0; ds = 0\r\n    dgk = 0; wk = 0; mvw = 0; pg = 0; th = 0; mvx = 0; pk = -1; q = -1\r\n    rt = 0; bt = 0; ro = 5; kf = 0\r\n    constructor(x: number, dir: number, ai: boolean) { this.x = x; this.dir = dir; this.ai = ai }\r\n}\r\nclass Inp { l = false; r = false; b = false; p = -1; dg = 0 }\r\nclass Fx { x = 0; y = 0; t = 0; y2 = 0; s = \"\"; c = 1; k = 0 }\r\nclass Pose {\r\n    lean = 0; tw = 0; cr = 2; lx = 30; ly = -100; rx = 16; ry = -96; hx = 0; hy = 0\r\n    exx = 0; exy = 0; step = 0; lb = 1; rb = 1\r\n}\r\n\r\nlet P: Fighter = new Fighter(220, 1, false)\r\nlet A: Fighter = new Fighter(580, -1, true)\r\nlet st: number[] = [0, 0, 0, 0, 0, 0, 0]\r\nlet tot: number[] = [0, 0, 0, 0, 0, 0, 0]\r\nlet w2: number[] = [0, 0]\r\nlet fxs: Fx[] = []\r\nlet state = ST_TITLE\r\nlet rnd = 1, frames = 0, introT = 0, koT = 0, tc = 0, lj = 0\r\nlet slow = 0, hs = 0, shk = 0, camX = 0, DF = 0.4\r\nlet tipT = 0, tipTxt = \"\", wt = false, tt = false, lp = -1, rp = 0\r\nlet pq = -1, pqT = 0, dq = 0, dqT = 0, pend = -1, pendT = 0\r\n\r\nconst TIPS = [\r\n    [\"Stance and guard\", \"Keep your hands up near your chin, elbows in, chin tucked. A good guard is your first defence.\", \"In the game: hold Down to block when you see the !\", \"Hands up, chin down.\"],\r\n    [\"Use the jab\", \"The jab is your fastest, safest punch. Use it to measure distance and set up other punches.\", \"In the game: it costs only 5 stamina.\", \"Jab to measure distance.\"],\r\n    [\"Punch in combinations\", \"Single punches are easy to block. Combinations like the 1-2 (jab then cross) create openings.\", \"In the game: throw the cross right after a jab.\", \"Follow a jab with a cross.\"],\r\n    [\"Return to guard\", \"A punch leaves you open until the hand is back. Reset your guard straight after throwing.\", \"In the game: a missed punch leaves you open to a counter.\", \"Hand back to guard.\"],\r\n    [\"Heavy punches need a setup\", \"Heavy punches are slow and tiring. Throw hooks and crosses when your opponent is tired, stunned or has just missed.\", \"In the game: a ! marks a heavy wind-up, and a quick jab can interrupt it.\", \"Heavy punches need setup.\"],\r\n    [\"Save your energy\", \"Wild swings burn energy and open your guard. Breathe out as you punch and pace yourself through each round.\", \"In the game: step back or block to recover stamina.\", \"Do not swing wildly.\"],\r\n    [\"Footwork and distance\", \"Stay balanced, never cross your feet, and move in and out of range instead of standing still in front of punches.\", \"In the game: step out of range before a heavy punch lands.\", \"Move in, punch, move out.\"],\r\n    [\"Dodge and counter\", \"Slipping or dodging just before a punch lands leaves your opponent off balance. Counter straight away.\", \"In the game: Up plus Right dashes in, Up standing still ducks, Up plus Left dashes away. A perfect dodge stuns them and your counter hits harder.\", \"Dodge late, then counter.\"],\r\n    [\"Train safely\", \"Learn with a qualified coach. Wear gloves, hand wraps, a mouthguard and headgear when sparring, and get checked after a hard hit to the head.\", \"This game does not replace real coaching.\", \"Train with a real coach.\"]\r\n]\r\n\r\nfunction tip(m: string) { if (tipT <= 0) { tipTxt = m; tipT = 150 } }\r\nfunction sfx(shape: WaveShape, f1: number, f2: number, ms: number, vol: number) {\r\n    music.play(music.createSoundEffect(shape, f1, f2, vol, 0, ms, SoundExpressionEffect.None, InterpolationCurve.Linear), music.PlaybackMode.InBackground)\r\n}\r\nfunction addFx(x: number, y: number, t: number, s: string, c: number, k: number) {\r\n    const f = new Fx(); f.x = x; f.y = y; f.t = t; f.s = s; f.c = c; f.k = k; fxs.push(f)\r\n}\r\n\r\n// ---------------- game logic ----------------\r\nfunction dodgeFx(a: Fighter, b: Fighter) {\r\n    if (b.ds <= 10) {\r\n        const pl = !a.ai\r\n        a.p = -1; a.t = 0; a.hit = false; a.stun = pl ? 22 : 30; a.exp = pl ? 40 : 50\r\n        b.sta = Math.min(100, b.sta + 12); b.pg = 30; slow = 45\r\n        sfx(WaveShape.Sine, 900, 500, 250, 180)\r\n        addFx(b.x, FY - 150, 60, \"PERFECT!\", 5, 0)\r\n        if (!b.ai) { st[PD]++; tip(\"Perfect dodge! Opponent open (stars). Counter!\") }\r\n        else tip(\"Your punch was perfectly dodged. Block and reset.\")\r\n    } else {\r\n        addFx(b.x, FY - 140, 34, \"DODGED\", 6, 0)\r\n        if (!b.ai) tip(\"Dodged, but early. Dodge closer to impact.\")\r\n    }\r\n}\r\n\r\nfunction strike(a: Fighter, b: Fighter) {\r\n    const k = PN[a.p]\r\n    const dist = Math.abs(a.x - b.x)\r\n    if (b.grace > 0 && dist <= k[5]) return\r\n    if (b.inv > 0 && dist <= k[5] + 45) { a.hit = true; dodgeFx(a, b); return }\r\n    if (dist > k[5] || b.inv > 0) return\r\n    a.hit = true\r\n    const ex = b.exp > 0\r\n    const bl = b.blk && b.p < 0 && b.stun == 0 && !ex\r\n    let dmg = k[3] * (a.sta < 20 ? 0.5 : 1) * (a.ai ? 0.55 + DF * 1.25 : 1)\r\n    if (ex) { dmg *= 1.6; if (!a.ai) { st[CN]++; tip(\"Counter hit! Punching after a dodge hurts more.\") } }\r\n    if (bl) {\r\n        dmg *= 0.15; b.sta = Math.max(0, b.sta - k[3] * 0.8 - 4); b.vx = a.dir * 2\r\n        sfx(WaveShape.Square, 220, 90, 70, 110)\r\n        if (!a.ai) { st[BK]++; tip(\"Blocked. Switch punches or wait for them to tire.\") }\r\n        else tip(\"Good block! Counter with a jab while they recover.\")\r\n    } else {\r\n        const rec = b.p >= 0 && b.t >= PN[b.p][0] + PN[b.p][1]\r\n        if (!a.ai && b.p > 0 && b.t < PN[b.p][0]) tip(\"You interrupted a heavy punch. Jabs are fast.\")\r\n        b.stun = Math.max(b.stun, a.p == 0 ? 10 : 16); b.p = -1; b.t = 0; b.hit = false\r\n        b.vx = a.dir * (3 + k[3] / 3); b.fl = 8\r\n        hs = (a.p == 0 ? 3 : (a.p == 2 ? 7 : 5)) + (ex ? 3 : 0)\r\n        shk = a.p == 2 ? 6 : 3\r\n        sfx(WaveShape.Sawtooth, a.p == 2 ? 140 : 200, 60, 140, 255)\r\n        if (b.ai && Math.random() < 0.4) b.rt = 45\r\n        if (!a.ai) st[LD]++\r\n        else {\r\n            st[GH]++\r\n            tip(rec ? \"Hit while recovering. Check range before swinging.\" : \"Hit with your guard down. Hold Down to block.\")\r\n        }\r\n    }\r\n    b.hp = Math.max(0, b.hp - dmg)\r\n    addFx(b.x, FY - 150, 36, bl ? \"BLOCK\" : (ex ? \"COUNTER \" : \"-\") + Math.round(dmg), bl ? 6 : 5, 0)\r\n    addFx(b.x + (a.x < b.x ? -16 : 16), FY - 125, 10, \"\", bl ? 6 : 1, 1)\r\n}\r\n\r\nfunction upd(f: Fighter, o: Fighter, i: Inp) {\r\n    if (f.fl > 0) f.fl--\r\n    if (f.mvw > 0) f.mvw--\r\n    if (f.inv > 0) f.inv--\r\n    if (f.grace > 0) f.grace--\r\n    if (f.exp > 0) f.exp--\r\n    if (f.inv > 0) f.ds++\r\n    f.x = Math.max(50, Math.min(750, f.x + f.vx)); f.vx *= 0.85\r\n    if (Math.abs(f.vx) < 0.1) f.vx = 0\r\n    if (f.dir > 0 && f.x > o.x - 34) f.x = o.x - 34\r\n    else if (f.dir < 0 && f.x < o.x + 34) f.x = o.x + 34\r\n    if (f.stun > 0) { f.stun--; f.blk = false; if (f.stun == 0) f.grace = 8; return }\r\n    if (f.p >= 0) {\r\n        f.t++\r\n        const k = PN[f.p]\r\n        if (f.t >= k[0] && f.t < k[0] + k[1] && !f.hit) strike(f, o)\r\n        if (f.t >= k[0] + k[1] + k[2]) { f.p = -1; f.t = 0; f.hit = false }\r\n        return\r\n    }\r\n    f.blk = i.b && f.sta > 1 && !(f.exp > 0)\r\n    if (i.dg > 0) {\r\n        const c = i.dg == 1 ? 5 : (i.dg == 2 ? 10 : 8)\r\n        if (f.sta >= c && !f.blk) {\r\n            f.sta -= c; f.inv = i.dg == 1 ? 20 : 16; f.dgk = i.dg; f.ds = 0\r\n            f.vx = i.dg == 2 ? f.dir * 9 : (i.dg == 3 ? -f.dir * 9 : 0)\r\n            addFx(f.x, FY, 18, \"\", 13, 2)\r\n            sfx(WaveShape.Triangle, 300, 200, 100, 90)\r\n            if (!f.ai) dq = 0\r\n            return\r\n        }\r\n    }\r\n    if (i.p >= 0 && !f.blk) {\r\n        const k = PN[i.p]\r\n        if (f.sta >= k[4]) {\r\n            if (!f.ai) {\r\n                st[TH]++; pq = -1\r\n                if (i.p == 0) lj = tc\r\n                else if (i.p == 1 && lj > 0 && tc - lj < 40) tip(\"Nice 1-2: jab to set up, cross to follow.\")\r\n                if (i.p == lp) rp++; else { lp = i.p; rp = 1 }\r\n                if (rp >= 4) tip(\"Mix up your punches. Repeats are easy to block.\")\r\n                if (f.sta < 20) { st[LO]++; tip(\"Exhausted punches are weak. Recover first.\") }\r\n            }\r\n            f.p = i.p; f.t = 0; f.hit = false; f.sta -= k[4]\r\n            sfx(WaveShape.Triangle, 420, 250, 70, 70)\r\n            return\r\n        } else if (!f.ai) { tip(\"Too tired for that punch. Recover first.\"); pq = -1 }\r\n    }\r\n    const mv = (i.r ? 1 : 0) - (i.l ? 1 : 0)\r\n    if (mv != 0 && !f.blk && !(f.dgk == 1 && f.inv > 0)) {\r\n        f.wk += 0.28; f.mvw = 6\r\n        const nx = f.x + mv * (mv == f.dir ? 2.8 : 2.2)\r\n        if (Math.abs(nx - o.x) > 48) f.x = nx\r\n    }\r\n    f.sta = Math.min(100, f.sta + (f.blk ? 0.06 : (mv != 0 ? 0.12 : 0.24)))\r\n}\r\n\r\nfunction aiIn(): Inp {\r\n    const i = new Inp()\r\n    const d = Math.abs(A.x - P.x)\r\n    const AG = 0.12 + DF * 0.75\r\n    if (A.rt > 0) A.rt--\r\n    if (A.bt > 0) { A.bt--; i.b = true }\r\n    if (P.p >= 0 && P.t == 1 && A.p < 0) A.ro = 3 + Math.randomRange(0, 11)\r\n    if (P.p >= 0 && P.t == Math.max(1, PN[P.p][0] - A.ro) && d < 125 && A.p < 0 && Math.random() < DF * 1.2) {\r\n        if (Math.random() < 0.75) { A.bt = 24; i.b = true }\r\n        else i.dg = Math.random() < 0.5 ? 1 : 3\r\n    }\r\n    if (A.p >= 0 || A.stun > 0) return i\r\n    A.th--\r\n    if (A.th <= 0) {\r\n        A.th = 10 + Math.randomRange(0, 15); A.mvx = 0; A.pk = -1\r\n        const pun = P.p >= 0 && P.t >= PN[P.p][0] + PN[P.p][1]\r\n        if (A.q >= 0) { A.pk = A.q; A.q = -1; A.th = 5 }\r\n        else if (A.sta < 22 || A.rt > 0) { A.mvx = d < 140 ? 1 : 0; if (A.sta < 22 && Math.random() < 0.5) A.bt = 20 }\r\n        else if (d > 100) A.mvx = -1\r\n        else if (pun || Math.random() < AG) {\r\n            const q = Math.random()\r\n            let pk = q < 0.5 ? 0 : (q < 0.78 ? 1 : (A.sta > 40 ? 2 : 0))\r\n            if (d > PN[pk][5] + 10) pk = 0\r\n            A.pk = pk\r\n            if (pk == 0 && Math.random() < 0.5) A.q = 1\r\n        } else A.mvx = Math.random() < 0.55 ? 1 : (Math.random() < 0.5 ? -1 : 0)\r\n    }\r\n    i.l = A.mvx < 0; i.r = A.mvx > 0; i.p = A.pk; A.pk = -1\r\n    return i\r\n}\r\n\r\nfunction pin(): Inp {\r\n    if (pendT > 0) { pendT--; if (pendT == 0 && pend >= 0) { pq = pend; pqT = 8; pend = -1 } }\r\n    if (pqT > 0) pqT--; else pq = -1\r\n    if (dqT > 0) dqT--; else dq = 0\r\n    const i = new Inp()\r\n    i.l = controller.left.isPressed(); i.r = controller.right.isPressed(); i.b = controller.down.isPressed()\r\n    i.p = pq; i.dg = dq\r\n    return i\r\n}\r\n\r\nfunction setup(first: boolean) {\r\n    if (first) { P = new Fighter(220, 1, false); A = new Fighter(580, -1, true); w2 = [0, 0]; tot = [0, 0, 0, 0, 0, 0, 0]; rnd = 1 }\r\n    else {\r\n        const h0 = P.hp, h1 = A.hp\r\n        P = new Fighter(220, 1, false); A = new Fighter(580, -1, true)\r\n        P.hp = Math.min(100, h0 + 15); A.hp = Math.min(100, h1 + 15)\r\n    }\r\n    st = [0, 0, 0, 0, 0, 0, 0]; frames = 2400; fxs = []\r\n    state = ST_INTRO; introT = 100; tipT = 0; tipTxt = \"\"; wt = false; tt = false\r\n    pq = -1; dq = 0; pend = -1; pendT = 0; slow = 0; hs = 0\r\n    sfx(WaveShape.Sine, 1000, 900, 600, 160)\r\n}\r\n\r\nfunction rows(x: number[]): string {\r\n    const acc = x[TH] > 0 ? Math.round(100 * x[LD] / x[TH]) : 0\r\n    return \"Punches: \" + x[TH] + \", landed \" + x[LD] + \" (\" + acc + \"%)\\nBlocked by foe: \" + x[BK] + \"\\nGuard-down hits: \" + x[GH] + \"\\nExhausted punches: \" + x[LO] + \"\\nPerfect dodges: \" + x[PD] + \", counters: \" + x[CN]\r\n}\r\nfunction advice(x: number[]): string {\r\n    if (x[LO] >= 2) return \"Stamina: you threw \" + x[LO] + \" punches while exhausted. Recover with Block or a step back first.\"\r\n    if (x[GH] > 2 && x[GH] >= x[LD]) return \"Defense: hit \" + x[GH] + \" times with your guard down. Watch the wind-up and hold Down.\"\r\n    if (x[TH] > 3 && x[LD] / x[TH] < 0.35) return \"Range: only \" + Math.round(100 * x[LD] / x[TH]) + \"% landed. Jab to measure distance before power punches.\"\r\n    if (x[PD] + x[CN] >= 2) return \"Reactions: \" + x[PD] + \" perfect dodges and \" + x[CN] + \" counters. Keep timing dodges just before punches land.\"\r\n    return \"Good balance of offense and defense. Try mixing punch types and moving off the line.\"\r\n}\r\nfunction tipFor(x: number[]): number {\r\n    if (x[LO] >= 2) return 5\r\n    if (x[GH] >= 3) return 0\r\n    if (x[TH] > 3 && x[LD] / x[TH] < 0.35) return 1\r\n    if (x[PD] == 0 && x[GH] > 1) return 7\r\n    return (rnd + x[TH]) % TIPS.length\r\n}\r\nfunction showTips() {\r\n    let s = \"BOXING TIPS AND TRICKS\\n\"\r\n    for (let i = 0; i < TIPS.length; i++) s += \"\\n\" + TIPS[i][0] + \". \" + TIPS[i][1] + \" \" + TIPS[i][2] + \"\\n\"\r\n    game.showLongText(s, DialogLayout.Full)\r\n}\r\nfunction chooseDiff() {\r\n    if (game.ask(\"Easy mode?\", \"A=yes B=no\")) DF = 0.2\r\n    else if (game.ask(\"Hard mode?\", \"A=yes B=no\")) DF = 0.6\r\n    else DF = 0.4\r\n}\r\nfunction endRound() {\r\n    for (let i = 0; i < 7; i++) tot[i] += st[i]\r\n    if (P.hp > A.hp) w2[0]++; else if (A.hp > P.hp) w2[1]++\r\n    const ko = P.hp <= 0 || A.hp <= 0\r\n    const over = ko || rnd >= 3\r\n    let txt = \"\"\r\n    if (over) {\r\n        const win = ko ? A.hp <= 0 : (w2[0] > w2[1] || (w2[0] == w2[1] && P.hp >= A.hp))\r\n        const t = TIPS[tipFor(tot)]\r\n        txt = (win ? \"YOU WIN\" : \"YOU LOSE\") + (ko ? \" BY KO\" : \" ON POINTS\") + \"\\nLearning matters more than the result.\\n\\n\" + rows(tot) + \"\\n\\nCoach: \" + advice(tot) + \"\\n\\nBoxing tip - \" + t[0] + \": \" + t[1] + \" \" + t[2]\r\n    } else {\r\n        const t = TIPS[tipFor(st)]\r\n        txt = \"ROUND \" + rnd + \" COMPLETE\\n\\n\" + rows(st) + \"\\n\\nCoach: \" + advice(st) + \"\\n\\nBoxing tip - \" + t[0] + \": \" + t[1] + \" \" + t[2]\r\n    }\r\n    state = ST_DIALOG\r\n    control.runInParallel(function () {\r\n        game.showLongText(txt, DialogLayout.Full)\r\n        if (game.ask(\"Boxing tips?\", \"A=yes B=no\")) showTips()\r\n        if (over) { chooseDiff(); setup(true) } else { rnd++; setup(false) }\r\n    })\r\n}\r\n\r\ngame.onUpdate(function () {\r\n    if (tipT > 0) tipT--\r\n    if (shk > 0) shk--\r\n    for (let i = 0; i < fxs.length; i++) { fxs[i].t--; fxs[i].y2 += 0.8 }\r\n    fxs = fxs.filter(function (f) { return f.t > 0 })\r\n    if (state == ST_INTRO) { introT--; if (introT <= 0) state = ST_FIGHT }\r\n    if (state == ST_KO) { koT--; if (koT <= 0) endRound() }\r\n    if (state == ST_FIGHT || state == ST_INTRO || state == ST_KO) {\r\n        const tg = Math.max(0, Math.min(800 - 160 / S, (P.x + A.x) / 2 - 80 / S))\r\n        camX += (tg - camX) * 0.12\r\n    }\r\n    if (state != ST_FIGHT) return\r\n    if (slow > 0) { slow--; if (slow % 3 != 0) return }\r\n    if (hs > 0) { hs--; return }\r\n    tc++; frames--\r\n    upd(P, A, pin()); upd(A, P, aiIn())\r\n    if (P.sta < 15 && !P.blk) tip(\"Stamina low. Block or step back to recover.\")\r\n    if (!wt && tipT <= 0 && A.p > 0 && A.t == 1) { wt = true; tip(\"The ! marks a heavy punch. Block or dodge late.\") }\r\n    if (A.sta < 25 && !tt && tipT <= 0) { tt = true; tip(\"Opponent tired. Good time for a heavy punch.\") }\r\n    else if (A.sta > 45) tt = false\r\n    if (P.hp <= 0 || A.hp <= 0) { state = ST_KO; koT = 75; sfx(WaveShape.Sawtooth, 90, 40, 500, 255) }\r\n    else if (frames <= 0) endRound()\r\n})\r\n\r\n// ---------------- input ----------------\r\ncontroller.A.onEvent(ControllerButtonEvent.Pressed, function () {\r\n    if (state != ST_FIGHT) return\r\n    if (pendT > 0 && pend == 1) { pq = 2; pqT = 8; pend = -1; pendT = 0 }\r\n    else { pend = 0; pendT = 3 }\r\n})\r\ncontroller.B.onEvent(ControllerButtonEvent.Pressed, function () {\r\n    if (state != ST_FIGHT) return\r\n    if (pendT > 0 && pend == 0) { pq = 2; pqT = 8; pend = -1; pendT = 0 }\r\n    else { pend = 1; pendT = 3 }\r\n})\r\ncontroller.up.onEvent(ControllerButtonEvent.Pressed, function () {\r\n    if (state != ST_FIGHT) return\r\n    dq = controller.right.isPressed() ? 2 : (controller.left.isPressed() ? 3 : 1); dqT = 8\r\n})\r\n\r\n// ---------------- drawing ----------------\r\nfunction sxw(wx: number): number { return Math.round((wx - camX) * S + (shk > 0 ? Math.randomRange(-1, 1) : 0)) }\r\nfunction syw(ly: number): number { return Math.round(FLOOR + ly * S) }\r\nfunction tl(t: Image, x1: number, y1: number, x2: number, y2: number, c: number, w: number) {\r\n    const h = Math.idiv(w, 2)\r\n    if (Math.abs(x2 - x1) >= Math.abs(y2 - y1)) { for (let o = -h; o < w - h; o++) t.drawLine(x1, y1 + o, x2, y2 + o, c) }\r\n    else { for (let o = -h; o < w - h; o++) t.drawLine(x1 + o, y1, x2 + o, y2, c) }\r\n}\r\nfunction ez(t: number): number { return t * t * (3 - 2 * t) }\r\n\r\nfunction calcPose(f: Fighter, ext: number, ph: number): Pose {\r\n    const o = new Pose()\r\n    const now = control.millis()\r\n    const bob = Math.sin(now / (f.sta < 25 ? 100 : 175) + f.x * 0.05)\r\n    o.cr = Math.abs(bob) * 2 + 2; o.ly = -100 + bob * 2; o.ry = -96 - bob * 2\r\n    const e0 = Math.max(0, ext)\r\n    if (f.blk) { o.lean = 0.1; o.cr = 10; o.lx = 24; o.ly = -122; o.rx = 16; o.ry = -126 }\r\n    else if (f.p >= 0) {\r\n        const k = PN[f.p]\r\n        const L = k[5] * 0.88\r\n        if (f.p == 0) { o.lx = 30 + L * ext; o.ly = -110; o.lean = 0.06 * ext; o.tw = 5 * ext; o.rx = 18; o.ry = -118; o.step = 6 * ext; o.lb = 1 - e0 * 0.85 }\r\n        else if (f.p == 1) { o.rx = 18 + L * ext; o.ry = -110; o.tw = 14 * ext; o.lean = 0.14 * ext; o.lx = 22; o.ly = -118; o.step = 10 * ext; o.rb = 1 - e0 * 0.85 }\r\n        else { o.lx = 30 + L * 0.8 * ext; o.ly = -114 - Math.sin(e0 * 3.14) * 6; o.tw = 12 * ext; o.lean = 0.1 * ext; o.rx = 18; o.ry = -118; o.step = 8 * ext; o.exx = (o.lx + 4) * 0.5 + 2; o.exy = -128 - e0 * 6; o.lb = -1 }\r\n        if (ph == 0 && f.p > 0) {\r\n            const w = ez(f.t / k[0])\r\n            const tr = Math.sin(now / 35) * 1.6 * w\r\n            if (f.p == 2) { o.lx = 30 - 34 * w; o.ly = -112 - 14 * w + tr; o.exx = 10 - 14 * w; o.exy = -124 - 8 * w; o.lean = -0.18 * w; o.tw = -12 * w; o.cr += 4 * w; o.step = -4 * w; o.lb = -1 }\r\n            else { o.rx = 18 - 26 * w; o.ry = -104 + tr; o.tw = -10 * w; o.lean = -0.12 * w; o.rb = 1; o.step = -3 * w }\r\n        }\r\n    }\r\n    else if (f.stun > 0) { const q = Math.min(1, f.stun / 16); o.lean = -0.22 * q; o.hx = -8 * q; o.ly = -84; o.ry = -84; o.cr = 6 }\r\n    else if (f.inv > 0) {\r\n        if (f.dgk == 1) { o.cr = 26; o.lean = 0.3; o.hy = 6; o.lx = 24; o.ly = -88; o.rx = 14; o.ry = -92 }\r\n        else if (f.dgk == 2) { o.lean = 0.36; o.cr = 10; o.lx = 36; o.ly = -100; o.rx = 8; o.ry = -96; o.step = 6 }\r\n        else { o.lean = -0.26; o.cr = 8; o.hx = -8 }\r\n    }\r\n    return o\r\n}\r\n\r\nfunction drawFighter(t: Image, f: Fighter, col: number, skin0: number, dark0: number) {\r\n    const d = f.dir\r\n    if (f.hp <= 0) {   // knocked out: lying on the mat\r\n        const bx = sxw(f.x), by = syw(-6)\r\n        tl(t, bx, by, bx - d * 16, by, skin0, 5); tl(t, bx - d * 4, by + 2, bx - d * 12, by + 2, col, 4)\r\n        t.fillCircle(bx - d * 19, by, 4, skin0); t.fillCircle(bx - d * 20, by - 1, 4, col)\r\n        t.print(\"X\", bx - d * 17, by - 3, 1, image.font5)\r\n        return\r\n    }\r\n    let ext = 0, ph = 0\r\n    if (f.p >= 0) {\r\n        const k = PN[f.p]\r\n        if (f.t < k[0]) ext = -0.18 * ez(f.t / k[0])\r\n        else if (f.t < k[0] + k[1]) ext = -0.18 + 1.18 * Math.min(1, (f.t - k[0] + 1) / k[1])\r\n        else ext = Math.max(0, 1 - (f.t - k[0] - k[1]) / k[2])\r\n        ph = f.t < k[0] ? 0 : (f.t < k[0] + k[1] ? 1 : 2)\r\n    }\r\n    const o = calcPose(f, ext, ph)\r\n    const e0 = Math.max(0, ext)\r\n    const flash = f.fl > 0 && f.fl % 4 < 2\r\n    const skin = flash ? 1 : skin0, dk = flash ? 1 : dark0\r\n    const hy0 = -48 + o.cr * 0.5\r\n    const cl = Math.cos(o.lean), sl = Math.sin(o.lean)\r\n    const bx = f.x + d * o.step\r\n    const wl = f.mvw > 0 ? Math.sin(f.wk) * 9 : 0\r\n    const RX = (px: number, py: number) => sxw(bx + d * (px * cl - (py - hy0) * sl))\r\n    const RY = (px: number, py: number) => syw(hy0 + px * sl + (py - hy0) * cl)\r\n    const X = (lx: number) => sxw(bx + d * lx)\r\n    t.fillRect(sxw(f.x) - 6, FLOOR, 12, 2, 15)\r\n    // legs\r\n    const hipX = X(0), hipY = syw(hy0)\r\n    const f1x = X(-16 - wl + (f.p == 1 ? 6 * e0 : 0)), f1y = syw(-Math.max(0, -wl) * 0.5)\r\n    const f2x = X(18 + wl), f2y = syw(-Math.max(0, wl) * 0.5)\r\n    tl(t, hipX, hipY, f1x, f1y, dk, 3); tl(t, hipX, hipY, f2x, f2y, skin, 3)\r\n    t.fillRect(Math.min(f1x, f1x + d * 4), f1y - 1, 5, 2, 15); t.fillRect(Math.min(f2x, f2x + d * 4), f2y - 1, 5, 2, 15)\r\n    // arms\r\n    const sx0 = 2 + o.tw, sy0 = -108 + o.cr\r\n    const arm = (gx: number, gy: number, bend: number, useEx: boolean, c: number) => {\r\n        const mx = useEx ? o.exx : (sx0 + gx) / 2 - 3\r\n        const my = useEx ? o.exy : (sy0 + gy) / 2 + 12 * bend\r\n        const a1 = RX(sx0, sy0), b1 = RY(sx0, sy0), a2 = RX(mx, my), b2 = RY(mx, my), a3 = RX(gx, gy), b3 = RY(gx, gy)\r\n        tl(t, a1, b1, a2, b2, c, 2); tl(t, a2, b2, a3, b3, c, 2)\r\n        t.fillCircle(a3, b3, 3, col); t.setPixel(a3 + d, b3 - 2, 1)\r\n    }\r\n    arm(o.rx, o.ry, o.rb, false, dk)\r\n    // torso, shorts\r\n    const ty = -118 + o.cr, tx = o.tw * 0.3\r\n    tl(t, RX(0, hy0 - 4), RY(0, hy0 - 4), RX(tx, ty + 14), RY(tx, ty + 14), skin, 9)\r\n    tl(t, RX(-6 + tx, ty + 8), RY(-6 + tx, ty + 8), RX(7 + tx, ty + 8), RY(7 + tx, ty + 8), skin, 3)\r\n    t.drawLine(RX(-3, ty + 34), RY(-3, ty + 34), RX(4, ty + 34), RY(4, ty + 34), dk)\r\n    t.drawLine(RX(-3, ty + 44), RY(-3, ty + 44), RX(4, ty + 44), RY(4, ty + 44), dk)\r\n    tl(t, RX(0, hy0 - 8), RY(0, hy0 - 8), RX(0, hy0 + 16), RY(0, hy0 + 16), col, 11)\r\n    t.drawLine(RX(-6, hy0 - 8), RY(-6, hy0 - 8), RX(6, hy0 - 8), RY(6, hy0 - 8), 1)\r\n    // head\r\n    const hxL = 3 + o.hx + o.tw * 0.5, hyL = -134 + o.cr + o.hy\r\n    const hx = RX(hxL, hyL), hy = RY(hxL, hyL)\r\n    t.fillCircle(hx, hy, 5, skin)\r\n    t.fillCircle(hx - d, hy - 1, 5, col); t.fillCircle(hx + d * 2, hy + 1, 3, skin)\r\n    t.fillCircle(hx - d, hy + 1, 2, col)\r\n    if (f.stun > 0) { t.setPixel(hx + d * 2, hy - 1, 15); t.setPixel(hx + d * 4, hy - 1, 15); t.setPixel(hx + d * 3, hy, 15) }\r\n    else { t.setPixel(hx + d * 3, hy, 15); t.setPixel(hx + d * 4, hy + 3, 1) }\r\n    if (f.sta < 25) t.setPixel(hx - d * 5, hy - 7 + Math.idiv(control.millis(), 60) % 8, 9)\r\n    arm(o.lx, o.ly, o.lb, f.p == 2, skin)\r\n    // charge ring, swoosh, dodge lines\r\n    const gx = f.p == 1 ? RX(o.rx, o.ry) : RX(o.lx, o.ly), gy = f.p == 1 ? RY(o.rx, o.ry) : RY(o.lx, o.ly)\r\n    if (f.p > 0 && ph == 0 && f.t > PN[f.p][0] * 0.4) t.drawCircle(gx, gy, 4 + Math.round(4 * f.t / PN[f.p][0]), 5)\r\n    if (f.p >= 0 && ph == 1) t.drawLine(gx - d * 12, gy, gx - d * 3, gy, 1)\r\n    if (f.inv > 0 && f.dgk != 1 && Math.abs(f.vx) > 1.5) {\r\n        const sg = f.vx > 0 ? 1 : -1\r\n        for (let i = 0; i < 3; i++) { const yy = syw(-(60 + i * 32)); t.drawLine(sxw(f.x - sg * 18), yy, sxw(f.x - sg * (46 + i * 10)), yy, 1) }\r\n    }\r\n    if (f.pg > 0) { f.pg--; t.drawCircle(sxw(f.x), syw(-80), 17, f.pg % 4 < 2 ? 5 : 1) }\r\n    if (f.exp > 0) {\r\n        for (let q = 0; q < 3; q++) { const an = control.millis() / 160 + q * 2.1; t.fillCircle(sxw(f.x + Math.cos(an) * 18), syw(-172 + Math.sin(an) * 5), 1, 5) }\r\n    }\r\n    if (f.p > 0 && f.t < PN[f.p][0]) { t.print(\"!\", sxw(f.x) - 1, syw(-178) + 1, 15, image.font8); t.print(\"!\", sxw(f.x) - 2, syw(-178), 5, image.font8) }\r\n}\r\n\r\nfunction drawArena(t: Image) {\r\n    const ft = syw(236 - FY), fb = syw(340 - FY)\r\n    t.fillRect(0, ft, 160, fb - ft, 12)\r\n    for (let i = -10; i <= 20; i++) t.drawLine(sxw(400 + i * 40), ft, sxw(400 + i * 60), fb, 11)\r\n    t.fillRect(0, fb, 160, 20, 15); t.fillRect(0, syw(342 - FY), 160, 1, 2)\r\n    const px = [20, 780]\r\n    for (let j = 0; j < 2; j++) { const x = sxw(px[j]); t.fillRect(x - 1, syw(92 - FY), 3, syw(324 - FY) - syw(92 - FY), 11) }\r\n    const ry = [118, 160, 202], rc = [2, 1, 2]\r\n    for (let j = 0; j < 3; j++) {\r\n        const y = syw(ry[j] - FY)\r\n        t.drawLine(sxw(20), y, sxw(780), y, rc[j]); t.drawLine(sxw(20), y + 1, sxw(780), y + 1, rc[j])\r\n        for (let k = 0; k < 2; k++) t.fillRect(sxw(px[k]) - 2, y - 1, 5, 4, 2)\r\n    }\r\n}\r\n\r\nfunction drawHud(t: Image) {\r\n    t.fillRect(0, 0, 160, 19, 15)\r\n    // player bars (left) and AI bars (right)\r\n    t.fillRect(1, 1, 62, 7, 12); t.fillRect(2, 2, Math.round(60 * P.hp / 100), 5, P.hp < 30 ? 2 : 7)\r\n    t.fillRect(1, 9, 62, 5, 12); t.fillRect(2, 10, Math.round(60 * P.sta / 100), 3, P.sta < 20 ? 2 : 5)\r\n    t.fillRect(97, 1, 62, 7, 12); const aw = Math.round(60 * A.hp / 100); t.fillRect(158 - aw, 2, aw, 5, A.hp < 30 ? 2 : 7)\r\n    t.fillRect(97, 9, 62, 5, 12); const sw = Math.round(60 * A.sta / 100); t.fillRect(158 - sw, 10, sw, 3, A.sta < 20 ? 2 : 5)\r\n    t.print(\"YOU\", 2, 14, 1, image.font5); t.print(\"CPU\", 144, 14, 1, image.font5)\r\n    const s = Math.max(0, Math.ceil(frames / 60))\r\n    t.printCenter(Math.idiv(s, 60) + \":\" + (s % 60 < 10 ? \"0\" : \"\") + (s % 60), 2, 1, image.font8)\r\n    t.printCenter(\"R\" + rnd + \"  \" + w2[0] + \"-\" + w2[1], 12, 5, image.font5)\r\n}\r\n\r\nfunction drawTip(t: Image) {\r\n    if (tipT <= 0 || tipTxt.length == 0) return\r\n    const words = tipTxt.split(\" \")\r\n    let l1 = \"\", l2 = \"\"\r\n    for (let i = 0; i < words.length; i++) {\r\n        if (l2.length == 0 && (l1.length + words[i].length + 1) <= 26) l1 += (l1.length > 0 ? \" \" : \"\") + words[i]\r\n        else l2 += (l2.length > 0 ? \" \" : \"\") + words[i]\r\n    }\r\n    t.print(l1, 2, 108, 1, image.font5)\r\n    if (l2.length > 0) t.print(l2, 2, 114, 1, image.font5)\r\n}\r\n\r\nfunction makeBg(): Image {\r\n    const b = image.create(160, 120)\r\n    b.fill(15)\r\n    const cc = [12, 8, 10, 14, 12, 11]\r\n    for (let row = 0; row < 4; row++) {\r\n        for (let x = -4; x < 168; x += 9) {\r\n            const hx = x + Math.randomRange(0, 4), hy = 26 + row * 11 + Math.randomRange(0, 3)\r\n            const c = cc[Math.randomRange(0, cc.length - 1)]\r\n            b.fillCircle(hx, hy, 3, c); b.fillRect(hx - 3, hy + 3, 7, 9, c)\r\n        }\r\n    }\r\n    for (let i = 0; i < 3; i++) { b.fillCircle(30 + i * 50, 21, 2, 5); b.drawLine(30 + i * 50, 22, 12 + i * 50, 70, 12); b.drawLine(30 + i * 50, 22, 48 + i * 50, 70, 12) }\r\n    return b\r\n}\r\n\r\nfunction drawFx(t: Image) {\r\n    for (let i = 0; i < fxs.length; i++) {\r\n        const f = fxs[i]\r\n        const x = sxw(f.x), y = syw(f.y - FY)\r\n        if (f.k == 0) { const px = x - f.s.length * 3; t.print(f.s, px + 1, y - Math.round(f.y2) + 1, 15, image.font5); t.print(f.s, px, y - Math.round(f.y2), f.c, image.font5) }\r\n        else if (f.k == 1) { const r = 2 + (10 - f.t); for (let a = 0; a < 8; a++) { const an = a * 0.785; t.drawLine(x + Math.round(Math.cos(an) * r), y + Math.round(Math.sin(an) * r), x + Math.round(Math.cos(an) * (r + 3)), y + Math.round(Math.sin(an) * (r + 3)), f.c) } }\r\n        else { const r = 2 + Math.round((18 - f.t) * 0.4); t.fillCircle(x - 3, y - 1, r, f.c); t.fillCircle(x + 3, y - 1, r, f.c) }\r\n    }\r\n}\r\n\r\nscene.setBackgroundImage(makeBg())\r\nscene.createRenderable(1, function (target: Image, camera: scene.Camera) {\r\n    drawArena(target)\r\n    drawFighter(target, A, 6, 14, 12)\r\n    drawFighter(target, P, 2, 13, 11)\r\n    // player marker\r\n    if (state != ST_TITLE) { const mx = sxw(P.x); target.fillRect(mx - 2, syw(-190), 5, 1, 2); target.fillRect(mx - 1, syw(-190) + 1, 3, 1, 2); target.setPixel(mx, syw(-190) + 2, 2) }\r\n    drawFx(target)\r\n    drawHud(target)\r\n    drawTip(target)\r\n    if (state == ST_INTRO) {\r\n        target.printCenter(introT > 40 ? \"ROUND \" + rnd : \"FIGHT!\", 40, 1, image.font8)\r\n        const t = TIPS[(rnd * 2 + w2[0] + w2[1]) % TIPS.length][3]\r\n        target.printCenter(\"TIP: \" + t, 54, 5, image.font5)\r\n    }\r\n    if (state == ST_KO) target.printCenter(\"K.O.!\", 40, 2, image.font8)\r\n})\r\n\r\n// ---------------- start ----------------\r\ngame.showLongText(\"BOXING TRAINING BOUT\\n\\nYou are a trainee in a boxing club. Fight 3 rounds against the CPU. The coach tracks your stamina, guard and range, then tells you what to improve. Learning matters more than winning.\\n\\nA simulation only. It does not replace a real coach.\", DialogLayout.Full)\r\ngame.showLongText(\"CONTROLS\\n\\nLeft/Right: move\\nA: jab\\nB: cross\\nA+B together: hook\\nUp: dodge. Hold Right to dash in, stand still to duck, hold Left to dash away.\\nDown (hold): block\\nMenu: pause\\n\\nA ! over a boxer means a heavy punch is winding up. Dodge just before it lands for a PERFECT dodge, then counter!\", DialogLayout.Full)\r\nif (game.ask(\"Boxing tips first?\", \"A=yes B=no\")) showTips()\r\nchooseDiff()\r\nsetup(true)","README.md":" ","assets.json":"","pxt.json":"{\n    \"name\": \"Alpha-demo Serious Game\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"device\": \"*\"\n    },\n    \"files\": [\n        \"main.ts\",\n        \"README.md\",\n        \"assets.json\"\n    ],\n    \"preferredEditor\": \"tsprj\",\n    \"languageRestriction\": \"javascript-only\"\n}\n"}},{"timestamp":1795671700286,"editorVersion":"4.1.32","text":{"main.ts":"// --- TEXT & STATS ---\r\nconst TH = 0, LD = 1, BK = 2, GH = 3, LO = 4, PD = 5, CN = 6\r\nconst TIPS: string[][] = [\r\n    [\"Stance & guard\", \"Hands by chin, elbows in.\", \"Hold Down to block on !\", \"Hands up, chin down.\"],\r\n    [\"Use the jab\", \"Fast, safe range finder.\", \"Costs only 5 stamina.\", \"Jab to measure range.\"],\r\n    [\"Combinations\", \"1-2 (jab-cross) opens guards.\", \"Cross right after a jab.\", \"Follow jab with cross.\"],\r\n    [\"Return to guard\", \"Reset guard after punching.\", \"Misses leave you open.\", \"Hand back to guard.\"],\r\n    [\"Setup heavies\", \"Throw heavies when foe tires.\", \"! marks wind-up; jab stops it.\", \"Heavy punches need setup.\"],\r\n    [\"Save energy\", \"Wild swings drain stamina.\", \"Step back or block to rest.\", \"Do not swing wildly.\"],\r\n    [\"Footwork\", \"Move in and out of range.\", \"Step back before heavies land.\", \"Move in, punch, out.\"],\r\n    [\"Dodge & counter\", \"Slip late to unbalance foe.\", \"Up+Right dash, Up duck, Up+Left back.\", \"Dodge late, then counter.\"],\r\n    [\"Train safely\", \"Wear gear & use a real coach.\", \"This game is just a sim.\", \"Train with a real coach.\"]\r\n]\r\n\r\nconst M_LOW = \"Stamina low. Block or step back.\", M_HVY = \"! = heavy punch. Block or dodge late.\"\r\nconst M_TRD = \"Foe tired. Good time for a heavy!\", M_CMB = \"Nice 1-2: jab setup, cross follow.\"\r\nconst M_MIX = \"Mix punches. Repeats get blocked.\", M_EXH = \"Exhausted punches are weak. Rest.\"\r\nconst M_NOE = \"Too tired for that punch. Recover.\", M_CNT = \"Counter hit! Extra damage!\"\r\nconst M_BLK = \"Blocked. Switch punches or wait.\", M_GBL = \"Good block! Counter with a jab.\"\r\nconst M_INT = \"Interrupted heavy! Jabs are fast.\", M_PRF = \"Perfect dodge! Foe stunned. Counter!\"\r\nconst M_PRD = \"Your punch was dodged! Block!\", M_ERL = \"Dodged early. Dodge closer to hit.\"\r\nconst M_HRC = \"Hit while recovering. Check range.\", M_HGD = \"Hit with guard down. Hold Down!\"\r\n\r\nfunction rows(x: number[]): string {\r\n    const acc = x[TH] > 0 ? Math.round(100 * x[LD] / x[TH]) : 0\r\n    return `Punches: ${x[TH]}, landed ${x[LD]} (${acc}%)\\nBlocked: ${x[BK]} | Guard-down: ${x[GH]}\\nExhausted: ${x[LO]} | Dodges: ${x[PD]}, Cnt: ${x[CN]}`\r\n}\r\nfunction advice(x: number[]): string {\r\n    if (x[LO] >= 2) return `Stamina: ${x[LO]} exhausted punches. Block or step back first.`\r\n    if (x[GH] > 2 && x[GH] >= x[LD]) return `Defense: hit ${x[GH]} times unguarded. Hold Down on !`\r\n    if (x[TH] > 3 && x[LD] / x[TH] < 0.35) return `Range: ${Math.round(100 * x[LD] / x[TH])}% landed. Jab to measure first.`\r\n    if (x[PD] + x[CN] >= 2) return `Reactions: ${x[PD]} perfect dodges, ${x[CN]} counters. Great timing!`\r\n    return \"Good balance. Mix punch types and move off the line.\"\r\n}\r\nfunction summaryText(x: number[], r: number, over: boolean, win: boolean, ko: boolean): string {\r\n    let idx = (r + x[TH]) % TIPS.length\r\n    if (x[LO] >= 2) idx = 5\r\n    else if (x[GH] >= 3) idx = 0\r\n    else if (x[TH] > 3 && x[LD] / x[TH] < 0.35) idx = 1\r\n    else if (x[PD] == 0 && x[GH] > 1) idx = 7\r\n    const t = TIPS[idx]\r\n    const head = over ? `${win ? \"YOU WIN\" : \"YOU LOSE\"}${ko ? \" BY KO\" : \" ON POINTS\"}\\nLearning > winning.` : `ROUND ${r} COMPLETE`\r\n    return `${head}\\n\\n${rows(x)}\\n\\nCoach: ${advice(x)}\\n\\nTip - ${t[0]}: ${t[1]} ${t[2]}`\r\n}\r\n\r\n// --- MAP & HUD ---\r\nconst S = 0.3, FY = 312, FLOOR = 98\r\nlet camX = 0, shk = 0, shx = 0, shy = 0, arenaImg = image.create(1, 1)\r\nclass Fx { constructor(public x: number, public y: number, public t: number, public s: string, public c: number, public k: number, public y2 = 0) { } }\r\nfunction sxw(wx: number) { return Math.round((wx - camX) * S + shx) }\r\nfunction syw(ly: number) { return Math.round(FLOOR + ly * S + shy) }\r\n\r\nfunction initMap() {\r\n    const b = image.create(160, 120); b.fill(15)\r\n    const cc = [12, 8, 10, 14, 11]\r\n    for (let r = 0; r < 4; r++) for (let x = -4; x < 168; x += 9) {\r\n        const hx = x + Math.randomRange(0, 4), hy = 26 + r * 11 + Math.randomRange(0, 3), c = cc[Math.randomRange(0, 4)]\r\n        b.fillCircle(hx, hy, 3, c); b.fillRect(hx - 3, hy + 3, 7, 9, c)\r\n    }\r\n    for (let i = 0; i < 3; i++) {\r\n        b.fillCircle(30 + i * 50, 21, 2, 5)\r\n        b.drawLine(30 + i * 50, 22, 12 + i * 50, 70, 12); b.drawLine(30 + i * 50, 22, 48 + i * 50, 70, 12)\r\n    }\r\n    scene.setBackgroundImage(b)\r\n\r\n    const a = image.create(240, 120)\r\n    const ft = Math.round(FLOOR + (236 - FY) * S), fb = Math.round(FLOOR + (340 - FY) * S)\r\n    a.fillRect(0, ft, 240, fb - ft, 12)\r\n    for (let i = -10; i <= 20; i++) a.drawLine(Math.round((400 + i * 40) * S), ft, Math.round((400 + i * 60) * S), fb, 11)\r\n    a.fillRect(0, fb, 240, 20, 15); a.fillRect(0, fb + 1, 240, 1, 2)\r\n    const top = Math.round(FLOOR + (92 - FY) * S), bot = Math.round(FLOOR + (324 - FY) * S)\r\n    a.fillRect(5, top, 3, bot - top, 11); a.fillRect(232, top, 3, bot - top, 11)\r\n    const ry = [118, 160, 202], rc = [2, 1, 2]\r\n    for (let j = 0; j < 3; j++) {\r\n        const y = Math.round(FLOOR + (ry[j] - FY) * S)\r\n        a.fillRect(6, y, 228, 2, rc[j]); a.fillRect(4, y - 1, 5, 4, 2); a.fillRect(231, y - 1, 5, 4, 2)\r\n    }\r\n    arenaImg = a\r\n}\r\n\r\nfunction renderScene(t: Image) {\r\n    shx = shk > 0 ? Math.randomRange(-1, 1) : 0; shy = shk > 0 ? Math.randomRange(-1, 1) : 0\r\n    t.drawTransparentImage(arenaImg, Math.round(-camX * S) + shx, shy)\r\n    drawFighter(t, A, 6, 14, 12); drawFighter(t, P, 2, 13, 11)\r\n    if (state != ST_TITLE) {\r\n        const mx = sxw(P.x), my = syw(-190)\r\n        t.fillRect(mx - 2, my, 5, 1, 2); t.fillRect(mx - 1, my + 1, 3, 1, 2); t.setPixel(mx, my + 2, 2)\r\n    }\r\n    for (const f of fxs) {\r\n        const x = sxw(f.x), y = syw(f.y - FY)\r\n        if (f.k == 0) {\r\n            const px = x - f.s.length * 3\r\n            t.print(f.s, px + 1, y - Math.round(f.y2) + 1, 15, image.font5)\r\n            t.print(f.s, px, y - Math.round(f.y2), f.c, image.font5)\r\n        } else if (f.k == 1) {\r\n            const r = 12 - f.t\r\n            for (let a = 0; a < 8; a++) {\r\n                const an = a * 0.785\r\n                t.drawLine(x + Math.round(Math.cos(an) * r), y + Math.round(Math.sin(an) * r), x + Math.round(Math.cos(an) * (r + 3)), y + Math.round(Math.sin(an) * (r + 3)), f.c)\r\n            }\r\n        } else {\r\n            const r = 2 + Math.round((18 - f.t) * 0.4)\r\n            t.fillCircle(x - 3, y - 1, r, f.c); t.fillCircle(x + 3, y - 1, r, f.c)\r\n        }\r\n    }\r\n    // HUD\r\n    t.fillRect(0, 0, 160, 19, 15)\r\n    t.fillRect(1, 1, 62, 7, 12); t.fillRect(2, 2, Math.round(0.6 * P.hp), 5, P.hp < 30 ? 2 : 7)\r\n    t.fillRect(1, 9, 62, 5, 12); t.fillRect(2, 10, Math.round(0.6 * P.sta), 3, P.sta < 20 ? 2 : 5)\r\n    const aw = Math.round(0.6 * A.hp), sw = Math.round(0.6 * A.sta)\r\n    t.fillRect(97, 1, 62, 7, 12); t.fillRect(158 - aw, 2, aw, 5, A.hp < 30 ? 2 : 7)\r\n    t.fillRect(97, 9, 62, 5, 12); t.fillRect(158 - sw, 10, sw, 3, A.sta < 20 ? 2 : 5)\r\n    t.print(\"YOU\", 2, 14, 1, image.font5); t.print(\"CPU\", 144, 14, 1, image.font5)\r\n    const s = Math.max(0, Math.ceil(frames / 60))\r\n    t.printCenter(`${Math.floor(s / 60)}:${s % 60 < 10 ? \"0\" : \"\"}${s % 60}`, 2, 1, image.font8)\r\n    t.printCenter(`R${roundNo}  ${w2[0]}-${w2[1]}`, 12, 5, image.font5)\r\n\r\n    if (tipT > 0 && tipTxt.length > 0) {\r\n        const words = tipTxt.split(\" \"); let l1 = \"\", l2 = \"\"\r\n        for (const w of words) {\r\n            if (!l2.length && l1.length + w.length + 1 <= 26) l1 += (l1 ? \" \" : \"\") + w\r\n            else l2 += (l2 ? \" \" : \"\") + w\r\n        }\r\n        t.print(l1, 2, 108, 1, image.font5)\r\n        if (l2) t.print(l2, 2, 114, 1, image.font5)\r\n    }\r\n    if (state == ST_INTRO) {\r\n        t.printCenter(introT > 40 ? `ROUND ${roundNo}` : \"FIGHT!\", 40, 1, image.font8)\r\n        t.printCenter(\"TIP: \" + TIPS[(roundNo * 2 + w2[0] + w2[1]) % TIPS.length][3], 54, 5, image.font5)\r\n    }\r\n    if (state == ST_KO) t.printCenter(\"K.O.!\", 40, 2, image.font8)\r\n}\r\n\r\n// --- CHARACTER ---\r\nconst PN = [[6, 3, 8, 4, 5, 92], [22, 4, 14, 10, 12, 104], [32, 4, 20, 15, 18, 88]]\r\nclass Fighter {\r\n    hp = 100; sta = 100; p = -1; t = 0; stun = 0; blk = false; inv = 0; vx = 0; fl = 0\r\n    hit = false; exp = 0; grace = 0; ds = 0; dgk = 0; wk = 0; mvw = 0; pg = 0; th = 0\r\n    mvx = 0; pk = -1; q = -1; rt = 0; bt = 0; ro = 5\r\n    constructor(public x: number, public dir: number, public ai: boolean) { }\r\n}\r\nfunction ez(t: number) { return t * t * (3 - 2 * t) }\r\nlet gBx = 0, gD = 1, gCl = 1, gSl = 0, gHy0 = 0\r\nfunction RX(px: number, py: number) { return sxw(gBx + gD * (px * gCl - (py - gHy0) * gSl)) }\r\nfunction RY(px: number, py: number) { return syw(gHy0 + px * gSl + (py - gHy0) * gCl) }\r\nfunction tl(t: Image, x1: number, y1: number, x2: number, y2: number, c: number, w: number) {\r\n    const h = Math.floor(w / 2), horiz = Math.abs(x2 - x1) >= Math.abs(y2 - y1)\r\n    for (let o = -h; o < w - h; o++) horiz ? t.drawLine(x1, y1 + o, x2, y2 + o, c) : t.drawLine(x1 + o, y1, x2 + o, y2, c)\r\n}\r\n\r\nfunction drawFighter(t: Image, f: Fighter, col: number, skin0: number, dark0: number) {\r\n    const d = f.dir\r\n    if (f.hp <= 0) {\r\n        const bx = sxw(f.x), by = syw(-6)\r\n        tl(t, bx, by, bx - d * 16, by, skin0, 5); tl(t, bx - d * 4, by + 2, bx - d * 12, by + 2, col, 4)\r\n        t.fillCircle(bx - d * 19, by, 4, skin0); t.fillCircle(bx - d * 20, by - 1, 4, col)\r\n        t.print(\"X\", bx - d * 17, by - 3, 1, image.font5); return\r\n    }\r\n    let ext = 0, ph = 0\r\n    if (f.p >= 0) {\r\n        const k = PN[f.p]\r\n        if (f.t < k[0]) ext = -0.18 * ez(f.t / k[0])\r\n        else if (f.t < k[0] + k[1]) { ext = -0.18 + 1.18 * Math.min(1, (f.t - k[0] + 1) / k[1]); ph = 1 }\r\n        else { ext = Math.max(0, 1 - (f.t - k[0] - k[1]) / k[2]); ph = 2 }\r\n    }\r\n    const now = control.millis(), bob = Math.sin(now / (f.sta < 25 ? 100 : 175) + f.x * 0.05), e0 = Math.max(0, ext)\r\n    let lean = 0, tw = 0, cr = Math.abs(bob) * 2 + 2, lx = 30, ly = -100 + bob * 2, rx = 16, ry = -96 - bob * 2\r\n    let hx = 0, hy = 0, exx = 0, exy = 0, step = 0, lb = 1, rb = 1\r\n\r\n    if (f.blk) { lean = 0.1; cr = 10; lx = 24; ly = -122; rx = 16; ry = -126 }\r\n    else if (f.p >= 0) {\r\n        const k = PN[f.p], L = k[5] * 0.88\r\n        if (f.p == 0) { lx = 30 + L * ext; ly = -110; lean = 0.06 * ext; tw = 5 * ext; rx = 18; ry = -118; step = 6 * ext; lb = 1 - e0 * 0.85 }\r\n        else if (f.p == 1) { rx = 18 + L * ext; ry = -110; tw = 14 * ext; lean = 0.14 * ext; lx = 22; ly = -118; step = 10 * ext; rb = 1 - e0 * 0.85 }\r\n        else { lx = 30 + L * 0.8 * ext; ly = -114 - Math.sin(e0 * 3.14) * 6; tw = 12 * ext; lean = 0.1 * ext; rx = 18; ry = -118; step = 8 * ext; exx = (lx + 4) * 0.5 + 2; exy = -128 - e0 * 6 }\r\n        if (ph == 0 && f.p > 0) {\r\n            const w = ez(f.t / k[0]), tr = Math.sin(now / 35) * 1.6 * w\r\n            if (f.p == 2) { lx = 30 - 34 * w; ly = -112 - 14 * w + tr; exx = 10 - 14 * w; exy = -124 - 8 * w; lean = -0.18 * w; tw = -12 * w; cr += 4 * w; step = -4 * w }\r\n            else { rx = 18 - 26 * w; ry = -104 + tr; tw = -10 * w; lean = -0.12 * w; rb = 1; step = -3 * w }\r\n        }\r\n    } else if (f.stun > 0) { const q = Math.min(1, f.stun / 16); lean = -0.22 * q; hx = -8 * q; ly = -84; ry = -84; cr = 6 }\r\n    else if (f.inv > 0) {\r\n        if (f.dgk == 1) { cr = 26; lean = 0.3; hy = 6; lx = 24; ly = -88; rx = 14; ry = -92 }\r\n        else if (f.dgk == 2) { lean = 0.36; cr = 10; lx = 36; ly = -100; rx = 8; ry = -96; step = 6 }\r\n        else { lean = -0.26; cr = 8; hx = -8 }\r\n    }\r\n\r\n    const flash = f.fl > 0 && f.fl % 4 < 2, skin = flash ? 1 : skin0, dk = flash ? 1 : dark0\r\n    gD = d; gBx = f.x + d * step; gCl = Math.cos(lean); gSl = Math.sin(lean); gHy0 = -48 + cr * 0.5\r\n    const wl = f.mvw > 0 ? Math.sin(f.wk) * 9 : 0\r\n    t.fillRect(sxw(f.x) - 6, FLOOR, 12, 2, 15)\r\n\r\n    const hipX = sxw(gBx), hipY = syw(gHy0), f1x = sxw(gBx + d * (-16 - wl + (f.p == 1 ? 6 * e0 : 0))), f1y = syw(-Math.max(0, -wl) * 0.5)\r\n    const f2x = sxw(gBx + d * (18 + wl)), f2y = syw(-Math.max(0, wl) * 0.5)\r\n    tl(t, hipX, hipY, f1x, f1y, dk, 3); tl(t, hipX, hipY, f2x, f2y, skin, 3)\r\n    t.fillRect(Math.min(f1x, f1x + d * 4), f1y - 1, 5, 2, 15); t.fillRect(Math.min(f2x, f2x + d * 4), f2y - 1, 5, 2, 15)\r\n\r\n    const drawArm = (gx: number, gy: number, bend: number, useEx: boolean, c: number) => {\r\n        const sx0 = 2 + tw, sy0 = -108 + cr, mx = useEx ? exx : (sx0 + gx) / 2 - 3, my = useEx ? exy : (sy0 + gy) / 2 + 12 * bend\r\n        const a1 = RX(sx0, sy0), b1 = RY(sx0, sy0), a2 = RX(mx, my), b2 = RY(mx, my), a3 = RX(gx, gy), b3 = RY(gx, gy)\r\n        tl(t, a1, b1, a2, b2, c, 2); tl(t, a2, b2, a3, b3, c, 2); t.fillCircle(a3, b3, 3, col); t.setPixel(a3 + gD, b3 - 2, 1)\r\n    }\r\n    drawArm(rx, ry, rb, false, dk)\r\n\r\n    const ty = -118 + cr, tx = tw * 0.3\r\n    tl(t, RX(0, gHy0 - 4), RY(0, gHy0 - 4), RX(tx, ty + 14), RY(tx, ty + 14), skin, 9)\r\n    tl(t, RX(-6 + tx, ty + 8), RY(-6 + tx, ty + 8), RX(7 + tx, ty + 8), RY(7 + tx, ty + 8), skin, 3)\r\n    tl(t, RX(0, gHy0 - 8), RY(0, gHy0 - 8), RX(0, gHy0 + 16), RY(0, gHy0 + 16), col, 11)\r\n    t.drawLine(RX(-6, gHy0 - 8), RY(-6, gHy0 - 8), RX(6, gHy0 - 8), RY(6, gHy0 - 8), 1)\r\n\r\n    const hxS = RX(3 + hx + tw * 0.5, -134 + cr + hy), hyS = RY(3 + hx + tw * 0.5, -134 + cr + hy)\r\n    t.fillCircle(hxS, hyS, 5, skin); t.fillCircle(hxS - d, hyS - 1, 5, col); t.fillCircle(hxS + d * 2, hyS + 1, 3, skin)\r\n    if (f.stun > 0) { t.setPixel(hxS + d * 2, hyS - 1, 15); t.setPixel(hxS + d * 4, hyS - 1, 15) }\r\n    else { t.setPixel(hxS + d * 3, hyS, 15); t.setPixel(hxS + d * 4, hyS + 3, 1) }\r\n    if (f.sta < 25) t.setPixel(hxS - d * 5, hyS - 7 + Math.floor(now / 60) % 8, 9)\r\n\r\n    drawArm(lx, ly, lb, f.p == 2, skin)\r\n\r\n    const gx = f.p == 1 ? RX(rx, ry) : RX(lx, ly), gy = f.p == 1 ? RY(rx, ry) : RY(lx, ly)\r\n    if (f.p > 0 && ph == 0 && f.t > PN[f.p][0] * 0.4) t.drawCircle(gx, gy, 4 + Math.round(4 * f.t / PN[f.p][0]), 5)\r\n    if (f.p >= 0 && ph == 1) t.drawLine(gx - d * 12, gy, gx - d * 3, gy, 1)\r\n    if (f.inv > 0 && f.dgk != 1 && Math.abs(f.vx) > 1.5) {\r\n        const sg = f.vx > 0 ? 1 : -1\r\n        for (let i = 0; i < 3; i++) t.drawLine(sxw(f.x - sg * 18), syw(-(60 + i * 32)), sxw(f.x - sg * (46 + i * 10)), syw(-(60 + i * 32)), 1)\r\n    }\r\n    if (f.pg > 0) t.drawCircle(sxw(f.x), syw(-80), 17, f.pg % 4 < 2 ? 5 : 1)\r\n    if (f.exp > 0) for (let q = 0; q < 3; q++) t.fillCircle(sxw(f.x + Math.cos(now / 160 + q * 2.1) * 18), syw(-172 + Math.sin(now / 160 + q * 2.1) * 5), 1, 5)\r\n    if (f.p > 0 && f.t < PN[f.p][0]) t.print(\"!\", sxw(f.x) - 2, syw(-178), 5, image.font8)\r\n}\r\n\r\n// --- MECHANICS & LOOP ---\r\nconst ST_TITLE = 0, ST_INTRO = 1, ST_FIGHT = 2, ST_KO = 3, ST_DIALOG = 4\r\nlet P = new Fighter(220, 1, false), A = new Fighter(580, -1, true)\r\nlet stats = [0, 0, 0, 0, 0, 0, 0], totals = [0, 0, 0, 0, 0, 0, 0], w2 = [0, 0], fxs: Fx[] = []\r\nlet state = ST_TITLE, roundNo = 1, frames = 0, introT = 0, koT = 0, tc = 0, lastJab = 0, slow = 0, hitStop = 0\r\nlet difficulty = 0.4, tipT = 0, tipTxt = \"\", seenHeavy = false, seenTired = false, lastPunch = -1, repeatN = 0\r\nlet pq = -1, pqT = 0, dq = 0, dqT = 0, pend = -1, pendT = 0, lastMs = 0, acc = 0\r\n\r\nfunction tip(m: string) { if (tipT <= 0) { tipTxt = m; tipT = 150 } }\r\nfunction sfx(sh: WaveShape, f1: number, f2: number, ms: number, v: number) {\r\n    music.play(music.createSoundEffect(sh, f1, f2, v, 0, ms, SoundExpressionEffect.None, InterpolationCurve.Linear), music.PlaybackMode.InBackground)\r\n}\r\n\r\nfunction strike(a: Fighter, b: Fighter) {\r\n    const k = PN[a.p], dist = Math.abs(a.x - b.x)\r\n    if (b.grace > 0 && dist <= k[5]) return\r\n    if (b.inv > 0 && dist <= k[5] + 45) {\r\n        a.hit = true\r\n        if (b.ds <= 10) {\r\n            const pl = !a.ai\r\n            a.p = -1; a.t = 0; a.hit = false; a.stun = pl ? 22 : 30; a.exp = pl ? 40 : 50\r\n            b.sta = Math.min(100, b.sta + 12); b.pg = 30; slow = 45\r\n            sfx(WaveShape.Sine, 900, 500, 250, 180); fxs.push(new Fx(b.x, FY - 150, 60, \"PERFECT!\", 5, 0))\r\n            if (!b.ai) { stats[PD]++; tip(M_PRF) } else tip(M_PRD)\r\n        } else {\r\n            fxs.push(new Fx(b.x, FY - 140, 34, \"DODGED\", 6, 0))\r\n            if (!b.ai) tip(M_ERL)\r\n        }\r\n        return\r\n    }\r\n    if (dist > k[5] || b.inv > 0) return\r\n    a.hit = true\r\n    const ex = b.exp > 0, bl = b.blk && b.p < 0 && b.stun == 0 && !ex\r\n    let dmg = k[3] * (a.sta < 20 ? 0.5 : 1) * (a.ai ? (0.55 + difficulty * 1.25) : 1)\r\n    if (ex) { dmg *= 1.6; if (!a.ai) { stats[CN]++; tip(M_CNT) } }\r\n    if (bl) {\r\n        dmg *= 0.15; b.sta = Math.max(0, b.sta - k[3] * 0.8 - 4); b.vx = a.dir * 2\r\n        sfx(WaveShape.Square, 220, 90, 70, 110)\r\n        if (!a.ai) { stats[BK]++; tip(M_BLK) } else tip(M_GBL)\r\n    } else {\r\n        const rec = b.p >= 0 && b.t >= PN[b.p][0] + PN[b.p][1]\r\n        if (!a.ai && b.p > 0 && b.t < PN[b.p][0]) tip(M_INT)\r\n        b.stun = Math.max(b.stun, a.p == 0 ? 10 : 16); b.p = -1; b.t = 0; b.hit = false\r\n        b.vx = a.dir * (3 + k[3] / 3); b.fl = 8; hitStop = (a.p == 0 ? 3 : (a.p == 2 ? 7 : 5)) + (ex ? 3 : 0); shk = a.p == 2 ? 6 : 3\r\n        sfx(WaveShape.Sawtooth, a.p == 2 ? 140 : 200, 60, 140, 255)\r\n        if (b.ai && Math.random() < 0.4) b.rt = 45\r\n        if (!a.ai) stats[LD]++ \r\n        else { stats[GH]++; tip(rec ? M_HRC : M_HGD) }\r\n    }\r\n    b.hp = Math.max(0, b.hp - dmg)\r\n    fxs.push(new Fx(b.x, FY - 150, 36, bl ? \"BLOCK\" : (ex ? \"COUNTER \" : \"-\") + Math.round(dmg), bl ? 6 : 5, 0))\r\n    fxs.push(new Fx(b.x + (a.x < b.x ? -16 : 16), FY - 125, 10, \"\", bl ? 6 : 1, 1))\r\n}\r\n\r\nfunction upd(f: Fighter, o: Fighter, l: boolean, r: boolean, b: boolean, p: number, dg: number) {\r\n    if (f.fl > 0) f.fl--; if (f.mvw > 0) f.mvw--; if (f.inv > 0) { f.inv--; f.ds++ }\r\n    if (f.grace > 0) f.grace--; if (f.exp > 0) f.exp--; if (f.pg > 0) f.pg--\r\n    f.x = Math.max(50, Math.min(750, f.x + f.vx)); f.vx *= 0.85\r\n    if (Math.abs(f.vx) < 0.1) f.vx = 0\r\n    if (f.dir > 0 && f.x > o.x - 34) f.x = o.x - 34\r\n    else if (f.dir < 0 && f.x < o.x + 34) f.x = o.x + 34\r\n    if (f.stun > 0) { f.stun--; f.blk = false; if (f.stun == 0) f.grace = 8; return }\r\n    if (f.p >= 0) {\r\n        f.t++; const k = PN[f.p]\r\n        if (f.t >= k[0] && f.t < k[0] + k[1] && !f.hit) strike(f, o)\r\n        if (f.t >= k[0] + k[1] + k[2]) { f.p = -1; f.t = 0; f.hit = false }\r\n        return\r\n    }\r\n    f.blk = b && f.sta > 1 && f.exp <= 0\r\n    if (dg > 0) {\r\n        const c = dg == 1 ? 5 : (dg == 2 ? 10 : 8)\r\n      