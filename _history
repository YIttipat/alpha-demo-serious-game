\r\n    const ex = b.exp > 0\r\n    const bl = b.blk && b.p < 0 && b.stun == 0 && !ex\r\n    let dmg = k[3] * (a.sta < 20 ? 0.5 : 1)\r\n    if (a.ai) dmg = dmg * (0.55 + difficulty * 1.25)\r\n    if (ex) {\r\n        dmg *= 1.6\r\n        if (!a.ai) { stats[CN]++; tip(M_COUNTER) }\r\n    }\r\n    if (bl) {\r\n        dmg *= 0.15\r\n        b.sta = Math.max(0, b.sta - k[3] * 0.8 - 4)\r\n        b.vx = a.dir * 2\r\n        sfx(WaveShape.Square, 220, 90, 70, 110)\r\n        if (!a.ai) { stats[BK]++; tip(M_BLOCKED) } else tip(M_GOOD_BLOCK)\r\n    } else {\r\n        const rec = b.p >= 0 && b.t >= PN[b.p][0] + PN[b.p][1]\r\n        if (!a.ai && b.p > 0 && b.t < PN[b.p][0]) tip(M_INTERRUPT)\r\n        b.stun = Math.max(b.stun, a.p == 0 ? 10 : 16)\r\n        b.p = -1; b.t = 0; b.hit = false\r\n        b.vx = a.dir * (3 + k[3] / 3)\r\n        b.fl = 8\r\n        hitStop = (a.p == 0 ? 3 : (a.p == 2 ? 7 : 5)) + (ex ? 3 : 0)\r\n        shk = a.p == 2 ? 6 : 3\r\n        sfx(WaveShape.Sawtooth, a.p == 2 ? 140 : 200, 60, 140, 255)\r\n        if (b.ai && Math.random() < 0.4) b.rt = 45\r\n        if (!a.ai) stats[LD]++\r\n        else { stats[GH]++; tip(rec ? M_HIT_RECOVER : M_HIT_GUARD) }\r\n    }\r\n    b.hp = Math.max(0, b.hp - dmg)\r\n    addFx(b.x, FY - 150, 36, bl ? \"BLOCK\" : (ex ? \"COUNTER \" : \"-\") + Math.round(dmg), bl ? 6 : 5, 0)\r\n    addFx(b.x + (a.x < b.x ? -16 : 16), FY - 125, 10, \"\", bl ? 6 : 1, 1)\r\n}\r\n\r\nfunction upd(f: Fighter, o: Fighter, i: Inp) {\r\n    if (f.fl > 0) f.fl--\r\n    if (f.mvw > 0) f.mvw--\r\n    if (f.inv > 0) f.inv--\r\n    if (f.grace > 0) f.grace--\r\n    if (f.exp > 0) f.exp--\r\n    if (f.pg > 0) f.pg--\r\n    if (f.inv > 0) f.ds++\r\n    f.x = Math.max(50, Math.min(750, f.x + f.vx))\r\n    f.vx *= 0.85\r\n    if (Math.abs(f.vx) < 0.1) f.vx = 0\r\n    if (f.dir > 0 && f.x > o.x - 34) f.x = o.x - 34\r\n    else if (f.dir < 0 && f.x < o.x + 34) f.x = o.x + 34\r\n    if (f.stun > 0) { f.stun--; f.blk = false; if (f.stun == 0) f.grace = 8; return }\r\n    if (f.p >= 0) {\r\n        f.t++\r\n        const k = PN[f.p]\r\n        if (f.t >= k[0] && f.t < k[0] + k[1] && !f.hit) strike(f, o)\r\n        if (f.t >= k[0] + k[1] + k[2]) { f.p = -1; f.t = 0; f.hit = false }\r\n        return\r\n    }\r\n    f.blk = i.b && f.sta > 1 && !(f.exp > 0)\r\n    if (i.dg > 0) {   // dodge: 1 duck, 2 dash in, 3 dash away\r\n        let c = 8\r\n        if (i.dg == 1) c = 5\r\n        else if (i.dg == 2) c = 10\r\n        if (f.sta >= c && !f.blk) {\r\n            f.sta -= c\r\n            f.inv = i.dg == 1 ? 20 : 16\r\n            f.dgk = i.dg\r\n            f.ds = 0\r\n            f.vx = 0\r\n            if (i.dg == 2) f.vx = f.dir * 9\r\n            else if (i.dg == 3) f.vx = -f.dir * 9\r\n            addFx(f.x, FY, 18, \"\", 13, 2)\r\n            sfx(WaveShape.Triangle, 300, 200, 100, 90)\r\n            if (!f.ai) dq = 0\r\n            return\r\n        }\r\n    }\r\n    if (i.p >= 0 && !f.blk) {\r\n        const k = PN[i.p]\r\n        if (f.sta >= k[4]) {\r\n            if (!f.ai) {\r\n                stats[TH]++\r\n                pq = -1\r\n                if (i.p == 0) lastJab = tc\r\n                else if (i.p == 1 && lastJab > 0 && tc - lastJab < 40) tip(M_COMBO)\r\n                if (i.p == lastPunch) repeatN++\r\n                else { lastPunch = i.p; repeatN = 1 }\r\n                if (repeatN >= 4) tip(M_MIX)\r\n                if (f.sta < 20) { stats[LO]++; tip(M_EXHAUSTED) }\r\n            }\r\n            f.p = i.p; f.t = 0; f.hit = false\r\n            f.sta -= k[4]\r\n            sfx(WaveShape.Triangle, 420, 250, 70, 70)\r\n            return\r\n        } else if (!f.ai) { tip(M_TOO_TIRED); pq = -1 }\r\n    }\r\n    const mv = (i.r ? 1 : 0) - (i.l ? 1 : 0)\r\n    if (mv != 0 && !f.blk && !(f.dgk == 1 && f.inv > 0)) {\r\n        f.wk += 0.28\r\n        f.mvw = 6\r\n        const nx = f.x + mv * (mv == f.dir ? 2.8 : 2.2)\r\n        if (Math.abs(nx - o.x) > 48) f.x = nx\r\n    }\r\n    f.sta = Math.min(100, f.sta + (f.blk ? 0.06 : (mv != 0 ? 0.12 : 0.24)))\r\n}\r\n\r\n// ---------- AI opponent ----------\r\nfunction aiIn(): Inp {\r\n    const i = new Inp()\r\n    const d = Math.abs(A.x - P.x)\r\n    const ag = 0.12 + difficulty * 0.75\r\n    if (A.rt > 0) A.rt--\r\n    if (A.bt > 0) { A.bt--; i.b = true }\r\n    if (P.p >= 0 && P.t == 1 && A.p < 0) A.ro = 3 + Math.randomRange(0, 11)\r\n    if (P.p >= 0 && P.t == Math.max(1, PN[P.p][0] - A.ro) && d < 125 && A.p < 0 && Math.random() < difficulty * 1.2) {\r\n        if (Math.random() < 0.75) { A.bt = 24; i.b = true }\r\n        else i.dg = Math.random() < 0.5 ? 1 : 3\r\n    }\r\n    if (A.p >= 0 || A.stun > 0) return i\r\n    A.th--\r\n    if (A.th <= 0) {\r\n        A.th = 10 + Math.randomRange(0, 15)\r\n        A.mvx = 0\r\n        A.pk = -1\r\n        const pun = P.p >= 0 && P.t >= PN[P.p][0] + PN[P.p][1]\r\n        if (A.q >= 0) { A.pk = A.q; A.q = -1; A.th = 5 }\r\n        else if (A.sta < 22 || A.rt > 0) {\r\n            A.mvx = d < 140 ? 1 : 0\r\n            if (A.sta < 22 && Math.random() < 0.5) A.bt = 20\r\n        } else if (d > 100) A.mvx = -1\r\n        else if (pun || Math.random() < ag) {\r\n            const q = Math.random()\r\n            let pk = 0\r\n            if (q >= 0.5 && q < 0.78) pk = 1\r\n            else if (q >= 0.78 && A.sta > 40) pk = 2\r\n            if (d > PN[pk][5] + 10) pk = 0\r\n            A.pk = pk\r\n            if (pk == 0 && Math.random() < 0.5) A.q = 1\r\n        } else A.mvx = Math.random() < 0.55 ? 1 : (Math.random() < 0.5 ? -1 : 0)\r\n    }\r\n    i.l = A.mvx < 0\r\n    i.r = A.mvx > 0\r\n    i.p = A.pk\r\n    A.pk = -1\r\n    return i\r\n}\r\n\r\n// ---------- player input ----------\r\nfunction pin(): Inp {\r\n    if (pendT > 0) { pendT--; if (pendT == 0 && pend >= 0) { pq = pend; pqT = 8; pend = -1 } }\r\n    if (pqT > 0) pqT--\r\n    else pq = -1\r\n    if (dqT > 0) dqT--\r\n    else dq = 0\r\n    const i = new Inp()\r\n    i.l = controller.left.isPressed()\r\n    i.r = controller.right.isPressed()\r\n    i.b = controller.down.isPressed()\r\n    i.p = pq\r\n    i.dg = dq\r\n    return i\r\n}\r\n\r\nfunction initInput() {\r\n    // A = jab, B = cross, A+B together = hook (3 frame window)\r\n    controller.A.onEvent(ControllerButtonEvent.Pressed, function () {\r\n        if (state != ST_FIGHT) return\r\n        if (pendT > 0 && pend == 1) { pq = 2; pqT = 8; pend = -1; pendT = 0 }\r\n        else { pend = 0; pendT = 3 }\r\n    })\r\n    controller.B.onEvent(ControllerButtonEvent.Pressed, function () {\r\n        if (state != ST_FIGHT) return\r\n        if (pendT > 0 && pend == 0) { pq = 2; pqT = 8; pend = -1; pendT = 0 }\r\n        else { pend = 1; pendT = 3 }\r\n    })\r\n    // Up = dodge: Right held = dash in, Left held = dash away, otherwise duck\r\n    controller.up.onEvent(ControllerButtonEvent.Pressed, function () {\r\n        if (state != ST_FIGHT) return\r\n        dq = controller.right.isPressed() ? 2 : (controller.left.isPressed() ? 3 : 1)\r\n        dqT = 8\r\n    })\r\n}\r\n\r\n// ---------- rounds ----------\r\nfunction setup(first: boolean) {\r\n    if (first) {\r\n        P = new Fighter(220, 1, false)\r\n        A = new Fighter(580, -1, true)\r\n        w2 = [0, 0]\r\n        totals = [0, 0, 0, 0, 0, 0, 0]\r\n        roundNo = 1\r\n    } else {\r\n        const h0 = P.hp\r\n        const h1 = A.hp\r\n        P = new Fighter(220, 1, false)\r\n        A = new Fighter(580, -1, true)\r\n        P.hp = Math.min(100, h0 + 15)\r\n        A.hp = Math.min(100, h1 + 15)\r\n    }\r\n    stats = [0, 0, 0, 0, 0, 0, 0]\r\n    frames = 2400\r\n    fxs = []\r\n    state = ST_INTRO\r\n    introT = 100\r\n    tipT = 0\r\n    tipTxt = \"\"\r\n    seenHeavy = false\r\n    seenTired = false\r\n    pq = -1; dq = 0; pend = -1; pendT = 0; slow = 0; hitStop = 0\r\n    lastMs = control.millis()\r\n    acc = 0\r\n    sfx(WaveShape.Sine, 1000, 900, 600, 160)\r\n}\r\n\r\nfunction showTips() {\r\n    for (let p = 0; p < 3; p++) game.showLongText(tipsPage(p), DialogLayout.Full)\r\n}\r\n\r\nfunction chooseDifficulty() {\r\n    if (game.ask(\"Easy mode?\", \"A=yes B=no\")) difficulty = 0.2\r\n    else if (game.ask(\"Hard mode?\", \"A=yes B=no\")) difficulty = 0.6\r\n    else difficulty = 0.4\r\n}\r\n\r\nfunction endRound() {\r\n    for (let i = 0; i < 7; i++) totals[i] += stats[i]\r\n    if (P.hp > A.hp) w2[0]++\r\n    else if (A.hp > P.hp) w2[1]++\r\n    const ko = P.hp <= 0 || A.hp <= 0\r\n    const over = ko || roundNo >= 3\r\n    let win = false\r\n    if (ko) win = A.hp <= 0\r\n    else win = w2[0] > w2[1] || (w2[0] == w2[1] && P.hp >= A.hp)\r\n    const txt = summaryText(over ? totals : stats, roundNo, over, win, ko)\r\n    state = ST_DIALOG\r\n    control.runInParallel(function () {\r\n        game.showLongText(txt, DialogLayout.Full)\r\n        if (game.ask(\"Boxing tips?\", \"A=yes B=no\")) showTips()\r\n        if (over) { chooseDifficulty(); setup(true) }\r\n        else { roundNo++; setup(false) }\r\n    })\r\n}\r\n\r\n// ---------- one game tick (runs at 60 per second) ----------\r\nfunction tick() {\r\n    if (tipT > 0) tipT--\r\n    if (shk > 0) shk--\r\n    for (let i = 0; i < fxs.length; i++) { fxs[i].t--; fxs[i].y2 += 0.8 }\r\n    fxs = fxs.filter(function (f: Fx) { return f.t > 0 })\r\n    if (state == ST_TITLE || state == ST_DIALOG) return\r\n    updateCamera((P.x + A.x) / 2)\r\n    if (state == ST_INTRO) { introT--; if (introT <= 0) state = ST_FIGHT; return }\r\n    if (state == ST_KO) { koT--; if (koT <= 0) endRound(); return }\r\n    if (slow > 0) { slow--; if (slow % 3 != 0) return }\r\n    if (hitStop > 0) { hitStop--; return }\r\n    tc++\r\n    frames--\r\n    upd(P, A, pin())\r\n    upd(A, P, aiIn())\r\n    if (P.sta < 15 && !P.blk) tip(M_STAMINA_LOW)\r\n    if (!seenHeavy && tipT <= 0 && A.p > 0 && A.t == 1) { seenHeavy = true; tip(M_HEAVY) }\r\n    if (A.sta < 25 && !seenTired && tipT <= 0) { seenTired = true; tip(M_FOE_TIRED) }\r\n    else if (A.sta > 45) seenTired = false\r\n    if (P.hp <= 0 || A.hp <= 0) { state = ST_KO; koT = 75; sfx(WaveShape.Sawtooth, 90, 40, 500, 255) }\r\n    else if (frames <= 0) endRound()\r\n}\r\n\r\n// fixed time step: the game speed stays the same on slow or fast screens\r\nfunction frame() {\r\n    const now = control.millis()\r\n    let dt = now - lastMs\r\n    lastMs = now\r\n    if (dt > 100) dt = 100\r\n    acc += dt\r\n    let n = 0\r\n    while (acc >= 16.7 && n < 3) { tick(); acc -= 16.7; n++ }\r\n    if (acc > 33) acc = 0\r\n}\r\n// MAIN: starts the game. All the work is done in the other files.\r\n//   text.ts       tips, coach messages, dialog text\r\n//   map.ts        arena, camera, HUD, effects\r\n//   character.ts  boxer data and drawing\r\n//   mechanic.ts   input, combat, AI, rounds, game loop\r\n// The start-up code runs in a parallel fiber so every file has finished loading first,\r\n// whatever order MakeCode lists the files in.\r\nfunction startGame() {\r\n    initMap()\r\n    initInput()\r\n    scene.createRenderable(1, function (target: Image, camera: scene.Camera) {\r\n        renderScene(target)\r\n    })\r\n    game.onUpdate(frame)\r\n    game.showLongText(TITLE_TEXT, DialogLayout.Full)\r\n    game.showLongText(CONTROLS_TEXT, DialogLayout.Full)\r\n    if (game.ask(\"Boxing tips first?\", \"A=yes B=no\")) showTips()\r\n    chooseDifficulty()\r\n    setup(true)\r\n}\r\ncontrol.runInParallel(startGame)"]]}]}]},{"timestamp":1795670722423,"editorVersion":"4.1.32","changes":[{"type":"edited","filename":"main.ts","patch":[{"start1":0,"length1":2135,"diffs":[[1,"// MAIN: starts the game. All the work is done in the other files.\r\n//   text.ts       questions, cues and every message\r\n//   character.ts  the boxer figure\r\n//   screens.ts    how each screen looks\r\n//   mechanic.ts   the drill, the bout and the buttons\r\n// Start-up runs in a parallel fiber so every file has finished loading first,\r\n// whatever order MakeCode lists the files in.\r\nfunction startGame() {\r\n    initInput()\r\n    scene.createRenderable(1, function (target: Image, camera: scene.Camera) {\r\n        renderScene(target)\r\n    })\r\n    game.onUpdate(frame)\r\n    setQuestion()\r\n"]]},{"start1":591,"length1":1099,"diffs":[[1,"control.runInParallel(startGame)\r\n"]]},{"start1":627,"length1":425,"diffs":[[1,"// TEXT: every question, cue and message in the game.\r\n// Edit this file to change the content. Use plain letters (no accents or fancy quotes).\r\n"]]},{"start1":774,"length1":607,"diffs":[[1,"const CAT_NAME = [\"Punch ID\", \"Defense\", \"Stamina\", \"Rules\"]\r\nconst STAGE_NAME = [\"Beginner Trainee\", \"Training\", \"Amateur\", \"Advanced\", \"Professional\"]\r\n"]]},{"start1":930,"length1":812,"diffs":[[1,"// ----- training drill: 5 scenarios -----\r\nconst Q_TEXT = [\r\n    \"Your opponent keeps the lead hand low and stands at long range. What do you throw?\",\r\n    \"A big right hand is coming at your head. Best defensive reply?\",\r\n    \"It is round 3 and your stamina is low. What is the smartest choice?\",\r\n    \"You are orthodox. Which foot and hand lead?\",\r\n    \"A punch lands below the belt. What do the rules say?\"\r\n]\r\nconst Q_OPT: string[][] = [\r\n    [\"Jab to the head\", \"Lead hook\", \"Uppercut\", \"Wait, hands down\"],\r\n    [\"Slip and counter\", \"Turn your back\", \"Drop your hands\", \"Walk straight forward\"],\r\n    [\"Throw wild hooks\", \"Step back, light jabs\", \"Stand still, hands down\", \"Rush forward\"],\r\n    [\"Left foot, left jab\", \"Right foot, right jab\", \"Either, no difference\", \"Neither\"],\r\n    [\"Foul: warn or deduct\", \"It is allowed\", \"It scores double\", \"The round ends\"]\r\n]\r\nconst Q_ANS = [0, 0, 1, 0, 0]\r\nconst Q_CAT = [0, 1, 2, 0, 3]     // index into CAT_NAME\r\nconst Q_WHY = [\r\n    \"The jab is the fastest, safest punch at distance, and a low hand leaves the head open.\",\r\n    \"Slipping moves your head off the line and sets up a counter. Dropping your guard or turning away leaves you exposed.\",\r\n    \"Light movement and jabs conserve energy. Wild power punches burn stamina quickly and open your guard.\",\r\n    \"Orthodox boxers stand with the left foot forward and lead with the left jab.\",\r\n    \"Punches below the belt are fouls. The referee may warn the boxer or deduct points.\"\r\n]\r\n"]]},{"start1":2424,"length1":2049,"diffs":[[1,"// ----- sparring: moves and opponent cues -----\r\n// move numbers: 0 Jab, 1 Cross, 2 Hook, 3 Block, 4 Slip, 5 Rest\r\nconst ACT_NAME = [\"Jab\", \"Cross\", \"Hook\", \"Block\", \"Slip\", \"Rest\"]\r\nconst ACT_POW = [5, 9, 13, 0, 7, 0]        // damage dealt when it is the right move\r\nconst ACT_COST = [5, 10, 15, 3, 5, -12]    // stamina cost (negative = recover)\r\n"]]},{"start1":2777,"length1":691,"diffs":[[1,"const CUE_TEXT = [\r\n    \"Opponent's lead hand drops low.\",\r\n    \"Opponent winds up a big hook.\",\r\n    \"Opponent is breathing hard and slowing.\",\r\n    \"Opponent holds a tight high guard.\"\r\n]\r\nconst CUE_TIP = [\r\n    \"A low hand is an opening. Use the fast, cheap jab or a cross.\",\r\n    \"Slip or block an incoming hook. Slipping also sets up a counter.\",\r\n    \"A tired opponent is the moment to commit to power punches.\",\r\n    \"Do not waste energy punching into a tight guard. Probe with a jab or recover.\"\r\n]\r\nconst CUE_ATK = [0, 1, 0, 0]                                   // 1 = the opponent is attacking\r\nconst CUE_GOOD: number[][] = [[0, 1], [4], [1, 2], [5, 0]]     // best moves for each cue\r\nconst CUE_OK: number[][] = [[2], [3], [0], [3]]                // acceptable moves\r\n"]]},{"start1":3559,"length1":1026,"diffs":[[1,"const MSG_TIRED = \"Too tired to throw that. Stamina matters.\"\r\nconst MSG_GOOD = \"Good read. \"\r\nconst MSG_OK = \"Acceptable, but not the best choice. \"\r\nconst MSG_BAD = \"Missed read. \"\r\nconst MSG_LOW_STA = \" Low stamina halved your power.\"\r\nconst MSG_START = \"Round 1. Read the cue, then choose.\"\r\nconst MSG_LOCKED = \"Spar vs AI is locked.\\n\\nScore 4 of 5 in the training drill to unlock it. Advancing depends on what you learn, not on fights won.\"\r\nconst MSG_NOTE = \"Learning matters more than the result. This counts how often you chose the best response to the cue.\"\r\n"]]},{"start1":4130,"length1":440,"diffs":[[1,"// splits text into lines that fit the screen\r\nfunction wrapText(s: string, maxChars: number): string[] {\r\n    const words = s.split(\" \")\r\n    const lines: string[] = []\r\n    let cur = \"\"\r\n    for (let i = 0; i < words.length; i++) {\r\n        const w = words[i]\r\n        if (cur.length == 0) cur = w\r\n        else if (cur.length + 1 + w.length <= maxChars) cur = cur + \" \" + w\r\n        else { lines.push(cur); cur = w }\r\n"]]},{"start1":4558,"length1":5113,"diffs":[[1,"    if (cur.length > 0) lines.push(cur)\r\n    return lines\r\n"]]},{"start1":4622,"length1":2127,"diffs":[[1,"// CHARACTER: the boxer figure used in the ring.\r\n// pose: 0 idle, 1 jab, 2 cross, 3 hook, 4 block, 5 slip, 6 hit, 7 step back\r\n// dir: 1 faces right, -1 faces left. col = shorts and gloves, skin = skin colour.\r\nfunction drawBoxer(t: Image, x: number, feet: number, dir: number, col: number, skin: number, pose: number) {\r\n    let ox = 0\r\n    let hdx = 0\r\n    let hdy = 0\r\n    if (pose == 5) { ox = -dir * 5; hdx = -dir * 3; hdy = 3 }\r\n    else if (pose == 6) { ox = -dir * 3; hdx = -dir * 2 }\r\n    else if (pose == 7) { ox = -dir * 5 }\r\n    const bob = Math.round(Math.sin(control.millis() / 220))\r\n    const bx = x + ox\r\n    const hip = feet - 9\r\n    const sx = bx + dir * 2\r\n    const sy = hip - 13 + bob\r\n    // glove positions (lead = front hand, rear = back hand)\r\n    let lx = bx + dir * 9\r\n    let ly = hip - 14 + bob\r\n    let rx = bx + dir * 5\r\n    let ry = hip - 11 + bob\r\n    if (pose == 1) { lx = bx + dir * 21; ly = hip - 15 }\r\n    else if (pose == 2) { rx = bx + dir * 21; ry = hip - 13; lx = bx + dir * 8; ly 