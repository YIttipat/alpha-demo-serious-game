 if (P.hp > A.hp) w2[0]++; else if (A.hp > P.hp) w2[1]++\r\n    const ko = P.hp <= 0 || A.hp <= 0, over = ko || roundNo >= 3\r\n    const win = ko ? A.hp <= 0 : (w2[0] > w2[1] || (w2[0] == w2[1] && P.hp >= A.hp))\r\n    const txt = summaryText(over ? totals : stats, roundNo, over, win, ko)\r\n    state = ST_DIALOG\r\n    control.runInParallel(function () {\r\n        game.showLongText(txt, DialogLayout.Full)\r\n        if (game.ask(\"Boxing tips?\", \"A=yes B=no\")) {\r\n            for (let p = 0; p < 3; p++) {\r\n                let s = `BOXING TIPS ${p + 1}/3\\n`\r\n                for (let i = p * 3; i < p * 3 + 3; i++) s += `\\n${TIPS[i][0]}. ${TIPS[i][1]} ${TIPS[i][2]}\\n`\r\n                game.showLongText(s, DialogLayout.Full)\r\n            }\r\n        }\r\n        if (over) {\r\n            difficulty = game.ask(\"Easy mode?\", \"A=yes B=no\") ? 0.2 : (game.ask(\"Hard mode?\", \"A=yes B=no\") ? 0.6 : 0.4)\r\n            setup(true)\r\n        } else { roundNo++; setup(false) }\r\n    })\r\n}\r\n\r\nfunction tick() {\r\n    tc++\r\n    if (shk > 0) shk--\r\n    if (tipT > 0) tipT--\r\n    for (let i = fxs.length - 1; i >= 0; i--) {\r\n        fxs[i].t--; if (fxs[i].k == 0) fxs[i].y2 += 0.35\r\n        if (fxs[i].t <= 0) fxs.removeAt(i)\r\n    }\r\n    camX += (Math.max(0, Math.min(800 - 160 / S, (P.x + A.x) * 0.5 - 80 / S)) - camX) * 0.12\r\n\r\n    if (state == ST_INTRO) { if (--introT <= 0) state = ST_FIGHT; return }\r\n    if (state == ST_KO) { if (--koT <= 0) endRound(); return }\r\n    if (state != ST_FIGHT) return\r\n\r\n    if (hitStop > 0) { hitStop--; return }\r\n    if (slow > 0 && --slow % 2 == 1) return\r\n\r\n    // Player input\r\n    if (pendT > 0 && --pendT == 0 && pend >= 0) { pq = pend; pqT = 8; pend = -1 }\r\n    if (pqT > 0) pqT--; else pq = -1\r\n    if (dqT > 0) dqT--; else dq = 0\r\n    upd(P, A, controller.left.isPressed(), controller.right.isPressed(), controller.down.isPressed(), pq, dq)\r\n\r\n    // AI input\r\n    let ab = fa